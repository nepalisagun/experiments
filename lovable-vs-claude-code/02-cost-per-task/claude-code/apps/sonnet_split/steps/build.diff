+import { describe, expect, it } from 'vitest'
+import { allocate, buildSummary, calculate, emptyBill, formatMoney, loadBill, parsePercent, parsePrice, type Bill } from './bill'
+
+const mk = (over: Partial<Bill> = {}): Bill => ({
+  ...emptyBill(),
+  people: [
+    { id: 'a', name: 'Ann' },
+    { id: 'b', name: 'Bob' },
+    { id: 'c', name: 'Cy' },
+  ],
+  ...over,
+})
+
+describe('parsePrice', () => {
+  it('parses valid values', () => {
+    expect(parsePrice('12.50').cents).toBe(1250)
+    expect(parsePrice('12,5').cents).toBe(1250)
+    expect(parsePrice('7').cents).toBe(700)
+    expect(parsePrice('.99').cents).toBe(99)
+    expect(parsePrice('0.1').cents).toBe(10)
+  })
+  it('rejects bad values', () => {
+    expect(parsePrice('-3').error).toMatch(/negative/)
+    expect(parsePrice('').error).toBeTruthy()
+    expect(parsePrice('abc').error).toBeTruthy()
+    expect(parsePrice('.').error).toBeTruthy()
+    expect(parsePrice('1.234').error).toMatch(/2 decimal/)
+    expect(parsePrice('0').error).toMatch(/greater than zero/)
+  })
+})
+
+describe('parsePercent', () => {
+  it('parses', () => {
+    expect(parsePercent('8.25', 'Tax').bp).toBe(825)
+    expect(parsePercent('', 'Tax').bp).toBe(0)
+  })
+  it('rejects', () => {
+    expect(parsePercent('-1', 'Tax').error).toMatch(/negative/)
+    expect(parsePercent('101', 'Tip').error).toMatch(/100/)
+    expect(parsePercent('x', 'Tip').error).toBeTruthy()
+  })
+})
+
+describe('allocate', () => {
+  it('sums exactly', () => {
+    expect(allocate(100, [1, 1, 1])).toEqual([34, 33, 33])
+    expect(allocate(0, [1, 2])).toEqual([0, 0])
+    expect(allocate(5, [0, 0])).toEqual([0, 0])
+  })
+  it('sums exactly for random inputs', () => {
+    for (let n = 0; n < 500; n++) {
+      const w = Array.from({ length: 1 + (n % 7) }, (_, i) => ((n * 31 + i * 17) % 1000) + 1)
+      const total = (n * 7919) % 100000
+      expect(allocate(total, w).reduce((a, b) => a + b, 0)).toBe(total)
+    }
+  })
+})
+
+describe('calculate', () => {
+  it('splits shared items evenly with cent rounding', () => {
+    const bill = mk({ items: [{ id: '1', name: 'Pizza', cents: 1000, people: ['a', 'b', 'c'] }] })
+    const t = calculate(bill)
+    expect(t.shares.map((s) => s.subtotal)).toEqual([334, 333, 333])
+    expect(t.total).toBe(1000)
+  })
+  it('applies tax and tip proportionally', () => {
+    const bill = mk({
+      tax: '10',
+      tip: '20',
+      items: [
+        { id: '1', name: 'Steak', cents: 3000, people: ['a'] },
+        { id: '2', name: 'Salad', cents: 1000, people: ['b'] },
+      ],
+    })
+    const t = calculate(bill)
+    expect(t.subtotal).toBe(4000)
+    expect(t.tax).toBe(400)
+    expect(t.tip).toBe(800)
+    expect(t.shares[0]).toMatchObject({ subtotal: 3000, tax: 300, tip: 600, total: 3900 })
+    expect(t.shares[1]).toMatchObject({ subtotal: 1000, tax: 100, tip: 200, total: 1300 })
+    expect(t.shares[2].total).toBe(0)
+    expect(t.total).toBe(5200)
+  })
+  it('person totals always add up to bill total', () => {
+    for (let n = 0; n < 300; n++) {
+      const items = Array.from({ length: 1 + (n % 5) }, (_, i) => ({
+        id: String(i),
+        name: 'x',
+        cents: ((n + 3) * (i + 7) * 37) % 9000 + 1,
+        people: ['a', 'b', 'c'].filter((_, k) => ((n >> k) + i) % 3 !== 0 || k === i % 3),
+      }))
+      const bill = mk({ items, tax: String((n % 130) / 7), tip: String((n % 90) / 3) })
+      const t = calculate(bill)
+      expect(t.shares.reduce((a, s) => a + s.total, 0)).toBe(t.total)
+      expect(t.shares.reduce((a, s) => a + s.tax, 0)).toBe(t.tax)
+      expect(t.shares.reduce((a, s) => a + s.tip, 0)).toBe(t.tip)
+      expect(t.total).toBe(t.subtotal + t.tax + t.tip)
+    }
+  })
+  it('ignores items with no valid people', () => {
+    const t = calculate(mk({ items: [{ id: '1', name: 'Ghost', cents: 500, people: ['zzz'] }] }))
+    expect(t.total).toBe(0)
+  })
+  it('handles no people / no items', () => {
+    expect(calculate(emptyBill()).total).toBe(0)
+  })
+})
+
+describe('formatMoney', () => {
+  it('formats by currency', () => {
+    expect(formatMoney(123456, 'USD')).toBe('$1,234.56')
+    expect(formatMoney(1250, 'EUR')).toContain('12,50')
+    expect(formatMoney(1250, 'EUR')).toContain('€')
+    expect(formatMoney(1250, 'PLN')).toContain('zł')
+  })
+})
+
+describe('buildSummary', () => {
+  it('contains names and totals', () => {
+    const s = buildSummary(mk({ tax: '10', items: [{ id: '1', name: 'A', cents: 1000, people: ['a'] }] }))
+    expect(s).toContain('Ann: $11.00')
+    expect(s).toContain('Total: $11.00')
+  })
+})
+
+describe('loadBill', () => {
+  it('round-trips and survives garbage', () => {
+    const b = mk({ tax: '5', currency: 'PLN', items: [{ id: '1', name: 'A', cents: 100, people: ['a', 'gone'] }] })
+    const r = loadBill(JSON.stringify(b))
+    expect(r.currency).toBe('PLN')
+    expect(r.items[0].people).toEqual(['a'])
+    expect(loadBill('not json')).toEqual(emptyBill())
+    expect(loadBill(null)).toEqual(emptyBill())
+    expect(loadBill('{"people":5,"currency":"XXX"}').currency).toBe('USD')
+  })
+})
diff --git a/src/lib/bill.ts b/src/lib/bill.ts
new file mode 100644
index 0000000..225f1dd
--- /dev/null
+++ b/src/lib/bill.ts
@@ -0,0 +1,158 @@
+export type Currency = 'USD' | 'EUR' | 'PLN'
+export const CURRENCIES: Currency[] = ['USD', 'EUR', 'PLN']
+
+export interface Person {
+  id: string
+  name: string
+}
+export interface Item {
+  id: string
+  name: string
+  cents: number
+  people: string[]
+}
+export interface Bill {
+  people: Person[]
+  items: Item[]
+  tax: string // percent, as typed
+  tip: string // percent, as typed
+  currency: Currency
+}
+
+export const emptyBill = (): Bill => ({ people: [], items: [], tax: '0', tip: '0', currency: 'USD' })
+
+/** Parse a money string into integer cents. Accepts "12", "12.5", "12,50". */
+export function parsePrice(raw: string): { cents?: number; error?: string } {
+  const s = raw.trim()
+  if (s === '') return { error: 'Enter a price.' }
+  if (s.startsWith('-')) return { error: 'Price cannot be negative.' }
+  if (!/^\d*[.,]?\d*$/.test(s) || !/\d/.test(s)) return { error: 'Price must be a number, e.g. 12.50.' }
+  const [whole, frac = ''] = s.replace(',', '.').split('.')
+  if (frac.length > 2) return { error: 'Price can have at most 2 decimal places.' }
+  const cents = Number(whole || '0') * 100 + Number(frac.padEnd(2, '0'))
+  if (!Number.isSafeInteger(cents) || cents > 100_000_000_00) return { error: 'Price is too large.' }
+  if (cents === 0) return { error: 'Price must be greater than zero.' }
+  return { cents }
+}
+
+/** Parse a percentage string into basis points (1% = 100). */
+export function parsePercent(raw: string, label: string): { bp?: number; error?: string } {
+  const s = raw.trim().replace(',', '.')
+  if (s === '') return { bp: 0 }
+  if (s.startsWith('-')) return { error: `${label} cannot be negative.` }
+  if (!/^(\d+\.?\d*|\.\d+)$/.test(s)) return { error: `${label} must be a number, e.g. 8.5.` }
+  const n = Number(s)
+  if (n > 100) return { error: `${label} cannot be more than 100%.` }
+  return { bp: Math.round(n * 100) }
+}
+
+/**
+ * Split `total` cents across `weights` proportionally using the largest-remainder
+ * method, so the parts are integers that sum exactly to `total`.
+ * Ties go to the earlier index (deterministic).
+ */
+export function allocate(total: number, weights: number[]): number[] {
+  const sum = weights.reduce((a, b) => a + b, 0)
+  if (weights.length === 0) return []
+  if (sum === 0) return weights.map(() => 0)
+  const base = weights.map((w) => Math.floor((total * w) / sum))
+  const rem = weights.map((w, i) => ({ i, r: (total * w) % sum }))
+  let left = total - base.reduce((a, b) => a + b, 0)
+  rem.sort((a, b) => b.r - a.r || a.i - b.i)
+  for (const { i } of rem) {
+    if (left <= 0) break
+    base[i]++
+    left--
+  }
+  return base
+}
+
+export interface PersonShare {
+  person: Person
+  subtotal: number
+  tax: number
+  tip: number
+  total: number
+}
+export interface Totals {
+  shares: PersonShare[]
+  subtotal: number
+  tax: number
+  tip: number
+  total: number
+}
+
+export function calculate(bill: Bill): Totals {
+  const ids = bill.people.map((p) => p.id)
+  const subtotals = ids.map(() => 0)
+  let subtotal = 0
+  for (const item of bill.items) {
+    const idxs = item.people.map((id) => ids.indexOf(id)).filter((i) => i >= 0)
+    if (idxs.length === 0) continue // invalid item: ignored until fixed
+    const parts = allocate(item.cents, idxs.map(() => 1))
+    idxs.forEach((pi, k) => (subtotals[pi] += parts[k]))
+    subtotal += item.cents
+  }
+  const taxBp = parsePercent(bill.tax, 'Tax').bp ?? 0
+  const tipBp = parsePercent(bill.tip, 'Tip').bp ?? 0
+  const tax = Math.round((subtotal * taxBp) / 10000)
+  const tip = Math.round((subtotal * tipBp) / 10000)
+  const taxParts = allocate(tax, subtotals)
+  const tipParts = allocate(tip, subtotals)
+  const shares = bill.people.map((person, i) => ({
+    person,
+    subtotal: subtotals[i],
+    tax: taxParts[i],
+    tip: tipParts[i],
+    total: subtotals[i] + taxParts[i] + tipParts[i],
+  }))
+  return { shares, subtotal, tax, tip, total: subtotal + tax + tip }
+}
+
+const LOCALES: Record<Currency, string> = { USD: 'en-US', EUR: 'de-DE', PLN: 'pl-PL' }
+
+export function formatMoney(cents: number, currency: Currency): string {
+  return new Intl.NumberFormat(LOCALES[currency], { style: 'currency', currency }).format(cents / 100)
+}
+
+export function buildSummary(bill: Bill): string {
+  const t = calculate(bill)
+  const m = (c: number) => formatMoney(c, bill.currency)
+  const lines = ['Bill summary', '']
+  for (const s of t.shares) {
+    lines.push(`${s.person.name}: ${m(s.total)} (items ${m(s.subtotal)}, tax ${m(s.tax)}, tip ${m(s.tip)})`)
+  }
+  lines.push('', `Subtotal: ${m(t.subtotal)}`, `Tax (${bill.tax || 0}%): ${m(t.tax)}`, `Tip (${bill.tip || 0}%): ${m(t.tip)}`, `Total: ${m(t.total)}`)
+  return lines.join('\n')
+}
+
+/** Restore a bill from untrusted JSON (localStorage); falls back to empty on anything odd. */
+export function loadBill(json: string | null): Bill {
+  const bill = emptyBill()
+  if (!json) return bill
+  try {
+    const d = JSON.parse(json)
+    if (!d || typeof d !== 'object') return bill
+    const people: Person[] = Array.isArray(d.people)
+      ? d.people.filter((p: Person) => p && typeof p.id === 'string' && typeof p.name === 'string')
+      : []
+    const ids = new Set(people.map((p) => p.id))
+    const items: Item[] = Array.isArray(d.items)
+      ? d.items
+          .filter(
+            (i: Item) =>
+              i && typeof i.id === 'string' && typeof i.name === 'string' && Number.isSafeInteger(i.cents) && i.cents > 0 && Array.isArray(i.people),
+          )
+          .map((i: Item) => ({ id: i.id, name: i.name, cents: i.cents, people: i.people.filter((p) => ids.has(p)) }))
+      : []
+    return {
+      people,
+      items,
+      tax: typeof d.tax === 'string' ? d.tax : '0',
+      tip: typeof d.tip === 'string' ? d.tip : '0',
+      currency: CURRENCIES.includes(d.currency) ? d.currency : 'USD',
+    }
+  } catch {
+    return bill
+  }
+}
