@@ -1 +1,47 @@
 @import "tailwindcss";
+
+@theme {
+  --color-bg: #ffffff;
+  --color-panel: #f6f7f9;
+  --color-line: #e2e5ea;
+  --color-fg: #1c2330;
+  --color-muted: #667085;
+  --color-accent: #4f46e5;
+  --color-accent-fg: #ffffff;
+  --color-sel: #e8e9fd;
+  --color-mark: #fde68a;
+  --color-danger: #dc2626;
+}
+:root.dark {
+  --color-bg: #12151c;
+  --color-panel: #1a1e27;
+  --color-line: #2c3240;
+  --color-fg: #e6e9ef;
+  --color-muted: #9aa3b5;
+  --color-accent: #8b93ff;
+  --color-accent-fg: #12151c;
+  --color-sel: #272c4a;
+  --color-mark: #8a6d00;
+  --color-danger: #f87171;
+}
+html, body, #root { height: 100%; }
+body { background: var(--color-bg); color: var(--color-fg); font-family: system-ui, sans-serif; }
+mark { background: var(--color-mark); color: inherit; border-radius: 2px; }
+
+.md { line-height: 1.6; overflow-wrap: anywhere; }
+.md > :first-child { margin-top: 0; }
+.md h1 { font-size: 1.8em; font-weight: 700; margin: 1em 0 .5em; border-bottom: 1px solid var(--color-line); padding-bottom: .2em; }
+.md h2 { font-size: 1.45em; font-weight: 700; margin: 1em 0 .5em; }
+.md h3 { font-size: 1.2em; font-weight: 600; margin: 1em 0 .4em; }
+.md h4, .md h5, .md h6 { font-weight: 600; margin: 1em 0 .4em; }
+.md p { margin: .7em 0; }
+.md ul { list-style: disc; padding-left: 1.5em; margin: .6em 0; }
+.md ol { list-style: decimal; padding-left: 1.5em; margin: .6em 0; }
+.md li.task { list-style: none; margin-left: -1.2em; }
+.md li.task input { margin-right: .4em; width: 1em; height: 1em; cursor: pointer; accent-color: var(--color-accent); vertical-align: -.1em; }
+.md a { color: var(--color-accent); text-decoration: underline; }
+.md code { background: var(--color-panel); border: 1px solid var(--color-line); padding: .1em .35em; border-radius: 4px; font-family: ui-monospace, Consolas, monospace; font-size: .9em; }
+.md pre { background: var(--color-panel); border: 1px solid var(--color-line); padding: .8em 1em; border-radius: 8px; overflow-x: auto; margin: .8em 0; }
+.md pre code { background: none; border: 0; padding: 0; }
+.md blockquote { border-left: 3px solid var(--color-line); padding-left: 1em; color: var(--color-muted); margin: .7em 0; }
+.md hr { border: 0; border-top: 1px solid var(--color-line); margin: 1.2em 0; }
