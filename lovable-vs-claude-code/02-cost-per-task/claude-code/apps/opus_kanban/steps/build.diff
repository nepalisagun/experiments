+
+function formatDate(iso: string) {
+  const [y, m, d] = iso.split('-').map(Number)
+  return new Date(y, m - 1, d).toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' })
+}
+
+type Editing = { mode: 'add'; column: ColumnId } | { mode: 'edit'; id: string } | null
+
 export default function App() {
-  return <main className="min-h-screen grid place-items-center"><h1 className="text-2xl font-semibold">Hello</h1></main>
+  const [cards, setCards] = useState<Card[]>(() => loadBoard())
+  const [filter, setFilter] = useState<Filter>({ query: '', priority: 'all' })
+  const [editing, setEditing] = useState<Editing>(null)
+  const [deletingId, setDeletingId] = useState<string | null>(null)
+  const [announcement, setAnnouncement] = useState('')
+  const [today, setToday] = useState(todayISO)
+  const focusAfterRender = useRef<string | null>(null)
+
+  // Persist on every change.
+  useEffect(() => {
+    saveBoard(cards)
+  }, [cards])
+
+  // Keep other tabs in sync, and roll "today" over at midnight.
+  useEffect(() => {
+    const onStorage = (e: StorageEvent) => {
+      if (e.key === STORAGE_KEY) setCards(loadBoard())
+    }
+    const timer = setInterval(() => setToday(todayISO()), 60_000)
+    window.addEventListener('storage', onStorage)
+    return () => {
+      window.removeEventListener('storage', onStorage)
