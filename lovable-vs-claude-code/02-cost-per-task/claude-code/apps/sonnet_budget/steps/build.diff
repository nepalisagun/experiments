+
+  const submit = (e: FormEvent) => {
+    e.preventDefault()
+    const { errors, cents } = validateTx({ type, amount, categoryId, date, note }, data.categories)
+    setErrors(errors)
+    if (Object.keys(errors).length || cents === null) return
+    onSave({ id: initial?.id ?? newId(), type, cents, categoryId, date, note: note.trim() })
+  }
+
+  const createCat = () => {
+    const r = addCategory(data.categories, newName, newColor)
+    if (r.error) return setCatError(r.error)
+    const created = r.categories[r.categories.length - 1]
+    setData((d) => ({ ...d, categories: r.categories }))
+    setCategoryId(created.id)
+    setNewName(''); setCatError(''); setShowCat(false)
+  }
+
+  const err = (m?: string, id?: string) => m && <p id={id} role="alert" className="mt-1 text-xs text-red-600">{m}</p>
+
+  return (
+    <div className="fixed inset-0 z-10 flex items-end justify-center bg-black/40 p-0 sm:items-center sm:p-4" onMouseDown={(e) => e.target === e.currentTarget && onClose()}>
+      <form
+        noValidate onSubmit={submit} role="dialog" aria-modal="true" aria-label={initial ? 'Edit transaction' : 'Add transaction'}
+        className="max-h-full w-full max-w-md space-y-3 overflow-y-auto rounded-t-2xl bg-white p-5 shadow-xl sm:rounded-2xl"
+      >
+        <h2 className="text-lg font-semibold">{initial ? 'Edit transaction' : 'Add transaction'}</h2>
+
+        <div className="grid grid-cols-2 gap-1 rounded-lg bg-slate-100 p-1" role="radiogroup" aria-label="Type">
+          {(['expense', 'income'] as const).map((t) => (
+            <button
+              type="button" key={t} role="radio" aria-checked={type === t} onClick={() => setType(t)}
+              className={`rounded-md py-1.5 text-sm font-medium capitalize ${type === t ? 'bg-white shadow-sm' : 'text-slate-500'}`}
+            >{t}</button>
+          ))}
+        </div>
+
+        <label className="block text-sm font-medium">Amount
+          <input className={`${input} mt-1`} inputMode="decimal" placeholder="0.00" value={amount} onChange={(e) => setAmount(e.target.value)} aria-invalid={!!errors.amount} autoFocus />
+          {err(errors.amount)}
+        </label>
+
+        <div>
+          <label htmlFor="tx-category" className="block text-sm font-medium">Category</label>
+          <select id="tx-category" className={`${input} mt-1`} value={categoryId} onChange={(e) => setCategoryId(e.target.value)}>
+            {data.categories.map((c) => <option key={c.id} value={c.id}>{c.name}</option>)}
+          </select>
+          {err(errors.categoryId)}
+          {showCat ? (
+            <div className="mt-2 space-y-1 rounded-lg bg-slate-50 p-2">
+              <div className="flex gap-2">
+                <input className={input} placeholder="New category name" aria-label="New category name" value={newName} onChange={(e) => setNewName(e.target.value)}
+                  onKeyDown={(e) => { if (e.key === 'Enter') { e.preventDefault(); createCat() } }} />
+                <input type="color" aria-label="New category colour" className="h-9 w-12 shrink-0 cursor-pointer rounded border border-slate-300" value={newColor} onChange={(e) => setNewColor(e.target.value)} />
+                <button type="button" className={`${btn} bg-slate-800 text-white`} onClick={createCat}>Add</button>
+              </div>
+              {err(catError)}
+            </div>
+          ) : (
+            <button type="button" className="mt-1 text-sm text-indigo-700 hover:underline" onClick={() => setShowCat(true)}>+ New category</button>
+          )}
+        </div>
+
+        <label className="block text-sm font-medium">Date
+          <input className={`${input} mt-1`} type="date" value={date} onChange={(e) => setDate(e.target.value)} aria-invalid={!!errors.date} />
+          {err(errors.date)}
+        </label>
+
+        <label className="block text-sm font-medium">Note <span className="font-normal text-slate-500">(optional)</span>
+          <input className={`${input} mt-1`} value={note} maxLength={200} onChange={(e) => setNote(e.target.value)} />
+        </label>
+
+        <div className="flex justify-end gap-2 pt-1">
+          <button type="button" className={`${btn} hover:bg-slate-100`} onClick={onClose}>Cancel</button>
+          <button type="submit" className={`${btn} bg-indigo-600 text-white hover:bg-indigo-700`}>Save</button>
+        </div>
+      </form>
+    </div>
+  )
 }
diff --git a/src/lib/logic.test.ts b/src/lib/logic.test.ts
new file mode 100644
index 0000000..7812009
--- /dev/null
+++ b/src/lib/logic.test.ts
@@ -0,0 +1,92 @@
+import { describe, expect, it } from 'vitest'
+import {
+  DEFAULT_CATEGORIES, addCategory, expensesByCategory, filterTxs, formatCents, inMonth, loadData, parseAmount,
+  saveData, shiftMonth, toCsv, totals, validateTx, type Transaction,
+} from './logic'
+
+const tx = (o: Partial<Transaction>): Transaction => ({ id: 'a', type: 'expense', cents: 100, categoryId: 'food', date: '2026-03-05', note: '', ...o })
+
+describe('money', () => {
+  it('parses without float errors', () => {
+    expect(parseAmount('0.1')).toBe(10)
+    expect(parseAmount('0.2')).toBe(20)
+    expect(parseAmount('19.99')).toBe(1999)
+    expect(parseAmount('1,5')).toBe(150)
+    expect(parseAmount('12')).toBe(1200)
+    expect(parseAmount('.5')).toBe(50)
+  })
+  it('rejects bad input', () => {
+    for (const s of ['', 'abc', '1.234', '1e3', '.', '-1', '1.2.3']) expect(parseAmount(s)).toBeNull()
+  })
+  it('0.1 + 0.2 shows 0.30', () => {
+    const t = totals([tx({ type: 'income', cents: parseAmount('0.1')! }), tx({ type: 'income', cents: parseAmount('0.2')! })])
+    expect(formatCents(t.income)).toBe('0.30')
+  })
+  it('formats', () => {
+    expect(formatCents(123456789)).toBe('1,234,567.89')
+    expect(formatCents(-5)).toBe('-0.05')
+    expect(formatCents(0)).toBe('0.00')
+  })
+})
+
+describe('validation', () => {
+  const ok = { type: 'expense' as const, amount: '5', categoryId: 'food', date: '2026-03-01', note: '' }
+  it('accepts valid', () => expect(validateTx(ok, DEFAULT_CATEGORIES)).toEqual({ errors: {}, cents: 500 }))
+  it('amount must be > 0', () => {
+    expect(validateTx({ ...ok, amount: '0' }, DEFAULT_CATEGORIES).errors.amount).toMatch(/greater than zero/)
+    expect(validateTx({ ...ok, amount: '-3' }, DEFAULT_CATEGORIES).errors.amount).toMatch(/greater than zero/)
+    expect(validateTx({ ...ok, amount: '' }, DEFAULT_CATEGORIES).errors.amount).toMatch(/required/)
+    expect(validateTx({ ...ok, amount: 'x' }, DEFAULT_CATEGORIES).errors.amount).toMatch(/valid amount/)
+  })
+  it('date required', () => expect(validateTx({ ...ok, date: '' }, DEFAULT_CATEGORIES).errors.date).toBe('Date is required.'))
+  it('category must exist', () => expect(validateTx({ ...ok, categoryId: 'zzz' }, DEFAULT_CATEGORIES).errors.categoryId).toBeTruthy())
+})
+
+describe('months & aggregation', () => {
+  it('shifts months across years', () => {
+    expect(shiftMonth('2026-01', -1)).toBe('2025-12')
+    expect(shiftMonth('2026-12', 1)).toBe('2027-01')
+  })
+  const txs = [
+    tx({ id: '1', type: 'income', cents: 100000, categoryId: 'other' }),
+    tx({ id: '2', cents: 2550 }),
+    tx({ id: '3', cents: 450, note: 'Coffee' }),
+    tx({ id: '4', cents: 999, date: '2026-04-01' }),
+  ]
+  it('scopes to month', () => expect(inMonth(txs, '2026-03')).toHaveLength(3))
+  it('totals', () => expect(totals(inMonth(txs, '2026-03'))).toEqual({ income: 100000, expenses: 3000, balance: 97000 }))
+  it('by category', () => expect(expensesByCategory(inMonth(txs, '2026-03'))).toEqual({ food: 3000 }))
+  it('filters', () => {
+    expect(filterTxs(txs, { categoryId: '', type: 'income', search: '' })).toHaveLength(1)
+    expect(filterTxs(txs, { categoryId: 'food', type: '', search: 'COFF' })).toHaveLength(1)
+    expect(filterTxs(txs, { categoryId: 'health', type: '', search: '' })).toHaveLength(0)
+  })
+})
+
+describe('csv', () => {
+  it('escapes and neutralises formulas', () => {
+    const csv = toCsv([tx({ cents: 123456, note: 'a "b", c' }), tx({ id: 'b', note: '=SUM(A1)', date: '2026-03-01' })], DEFAULT_CATEGORIES)
+    const lines = csv.split('\r\n')
+    expect(lines[0]).toBe('Date,Type,Category,Amount,Note')
+    expect(lines[1]).toBe("2026-03-01,expense,Food,1.00,'=SUM(A1)")
+    expect(lines[2]).toBe('2026-03-05,expense,Food,1234.56,"a ""b"", c"')
+  })
+})
+
+describe('categories & persistence', () => {
+  it('adds and rejects duplicates', () => {
+    const r = addCategory(DEFAULT_CATEGORIES, ' Pets ', '#000000')
+    expect(r.categories).toHaveLength(7)
+    expect(addCategory(r.categories, 'pets', '#fff').error).toBeTruthy()
+    expect(addCategory(r.categories, '  ', '#fff').error).toBeTruthy()
+  })
+  it('round-trips through storage and survives corrupt data', () => {
+    const mem: Record<string, string> = {}
+    const st = { getItem: (k: string) => mem[k] ?? null, setItem: (k: string, v: string) => void (mem[k] = v) }
+    const data = { transactions: [tx({})], categories: DEFAULT_CATEGORIES, budgets: { food: 5000 } }
+    saveData(st, data)
+    expect(loadData(st)).toEqual(data)
+    mem['budget-tracker-v1'] = '{not json'
+    expect(loadData(st).transactions).toEqual([])
+  })
+})
diff --git a/src/lib/logic.ts b/src/lib/logic.ts
new file mode 100644
index 0000000..e7309bc
--- /dev/null
+++ b/src/lib/logic.ts
@@ -0,0 +1,199 @@
+export type TxType = 'income' | 'expense'
+
+export interface Category {
+  id: string
+  name: string
+  color: string
+}
+
+export interface Transaction {
+  id: string
+  type: TxType
+  cents: number
+  categoryId: string
+  date: string // YYYY-MM-DD
+  note: string
+}
+
+export interface AppData {
+  transactions: Transaction[]
+  categories: Category[]
+  budgets: Record<string, number> // categoryId -> cents per month
+}
+
+export const DEFAULT_CATEGORIES: Category[] = [
+  { id: 'food', name: 'Food', color: '#f97316' },
+  { id: 'housing', name: 'Housing', color: '#6366f1' },
+  { id: 'transport', name: 'Transport', color: '#0ea5e9' },
+  { id: 'fun', name: 'Fun', color: '#ec4899' },
+  { id: 'health', name: 'Health', color: '#10b981' },
+  { id: 'other', name: 'Other', color: '#64748b' },
+]
+
+/** Parse a user-typed amount into integer cents without floats. Returns null if invalid. */
+export function parseAmount(input: string): number | null {
+  const s = input.trim().replace(',', '.')
+  const m = /^(\d*)(?:\.(\d{0,2}))?$/.exec(s)
+  if (!m || (m[1] === '' && !m[2])) return null
+  const whole = parseInt(m[1] || '0', 10)
+  const frac = parseInt((m[2] ?? '').padEnd(2, '0'), 10)
+  const cents = whole * 100 + frac
+  return Number.isSafeInteger(cents) ? cents : null
+}
+
+/** Format integer cents as e.g. "1,234.50". */
+export function formatCents(cents: number): string {
+  const neg = cents < 0
+  const abs = Math.abs(cents)
+  const whole = Math.floor(abs / 100).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ',')
+  const frac = (abs % 100).toString().padStart(2, '0')
+  return `${neg ? '-' : ''}${whole}.${frac}`
+}
+
+export interface FormInput {
+  type: TxType
+  amount: string
+  categoryId: string
+  date: string
+  note: string
+}
+
+export type FormErrors = Partial<Record<'amount' | 'date' | 'categoryId', string>>
+
+export function validateTx(f: FormInput, categories: Category[]): { errors: FormErrors; cents: number | null } {
+  const errors: FormErrors = {}
+  let cents: number | null = null
+  if (f.amount.trim() === '') errors.amount = 'Amount is required.'
+  else {
+    cents = parseAmount(f.amount)
+    if (/^\s*-/.test(f.amount) || cents === 0) errors.amount = 'Amount must be greater than zero.'
+    else if (cents === null) errors.amount = 'Enter a valid amount, e.g. 12.50 (max 2 decimals).'
+  }
+  if (!f.date) errors.date = 'Date is required.'
+  else if (!/^\d{4}-\d{2}-\d{2}$/.test(f.date) || Number.isNaN(Date.parse(f.date))) errors.date = 'Enter a valid date.'
+  if (!categories.some((c) => c.id === f.categoryId)) errors.categoryId = 'Choose a category.'
+  return { errors, cents: errors.amount ? null : cents }
+}
+
+export const monthKey = (date: string) => date.slice(0, 7)
+
+export function shiftMonth(key: string, delta: number): string {
+  const [y, m] = key.split('-').map(Number)
+  const idx = y * 12 + (m - 1) + delta
+  return `${Math.floor(idx / 12)}-${String((idx % 12) + 1).padStart(2, '0')}`
+}
+
+export function monthLabel(key: string): string {
+  const [y, m] = key.split('-').map(Number)
+  return new Date(y, m - 1, 1).toLocaleString('en-US', { month: 'long', year: 'numeric' })
+}
+
+export const currentMonth = () => {
+  const d = new Date()
+  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`
+}
+
+export const todayStr = () => {
+  const d = new Date()
+  return `${currentMonth()}-${String(d.getDate()).padStart(2, '0')}`
+}
+
+export const inMonth = (txs: Transaction[], key: string) => txs.filter((t) => monthKey(t.date) === key)
+
+export function totals(txs: Transaction[]) {
+  let income = 0
+  let expenses = 0
+  for (const t of txs) {
+    if (t.type === 'income') income += t.cents
+    else expenses += t.cents
+  }
+  return { income, expenses, balance: income - expenses }
+}
+
+export function expensesByCategory(txs: Transaction[]): Record<string, number> {
+  const out: Record<string, number> = {}
+  for (const t of txs) if (t.type === 'expense') out[t.categoryId] = (out[t.categoryId] ?? 0) + t.cents
+  return out
+}
+
+export interface Filters {
+  categoryId: string // '' = all
+  type: '' | TxType
+  search: string
+}
+
+export function filterTxs(txs: Transaction[], f: Filters): Transaction[] {
+  const q = f.search.trim().toLowerCase()
+  return txs.filter(
+    (t) =>
+      (!f.categoryId || t.categoryId === f.categoryId) &&
+      (!f.type || t.type === f.type) &&
+      (!q || t.note.toLowerCase().includes(q)),
+  )
+}
+
+export const sortTxs = (txs: Transaction[]) =>
+  [...txs].sort((a, b) => b.date.localeCompare(a.date) || b.id.localeCompare(a.id))
+
+function csvCell(v: string): string {
+  // Neutralise spreadsheet formula injection, then quote if needed.
+  const safe = /^[=+\-@\t\r]/.test(v) ? `'${v}` : v
+  return /[",\n\r]/.test(safe) ? `"${safe.replace(/"/g, '""')}"` : safe
+}
+
+export function toCsv(txs: Transaction[], categories: Category[]): string {
+  const name = (id: string) => categories.find((c) => c.id === id)?.name ?? id
+  const rows = sortTxs(txs)
+    .reverse()
+    .map((t) => [t.date, t.type, name(t.categoryId), formatCents(t.cents).replace(/,/g, ''), t.note].map(csvCell).join(','))
+  return ['Date,Type,Category,Amount,Note', ...rows].join('\r\n')
+}
+
+export function addCategory(
+  categories: Category[],
+  name: string,
+  color: string,
+): { categories: Category[]; error?: string } {
+  const n = name.trim()
+  if (!n) return { categories, error: 'Category name is required.' }
+  if (categories.some((c) => c.name.toLowerCase() === n.toLowerCase()))
+    return { categories, error: 'A category with that name already exists.' }
+  const id = `c_${Date.now().toString(36)}${Math.random().toString(36).slice(2, 6)}`
+  return { categories: [...categories, { id, name: n, color }] }
+}
+
+export const STORAGE_KEY = 'budget-tracker-v1'
+
+export function loadData(storage: Pick<Storage, 'getItem'>): AppData {
+  const fresh: AppData = { transactions: [], categories: DEFAULT_CATEGORIES, budgets: {} }
+  try {
+    const raw = storage.getItem(STORAGE_KEY)
+    if (!raw) return fresh
+    const p = JSON.parse(raw)
+    const txs: Transaction[] = Array.isArray(p.transactions)
+      ? p.transactions.filter(
+          (t: Transaction) =>
+            t && typeof t.id === 'string' && Number.isSafeInteger(t.cents) && typeof t.date === 'string' &&
+            (t.type === 'income' || t.type === 'expense') && typeof t.categoryId === 'string',
+        ).map((t: Transaction) => ({ ...t, note: typeof t.note === 'string' ? t.note : '' }))
+      : []
+    const cats: Category[] =
+      Array.isArray(p.categories) && p.categories.length
+        ? p.categories.filter((c: Category) => c && typeof c.id === 'string' && typeof c.name === 'string')
+        : DEFAULT_CATEGORIES
+    const budgets: Record<string, number> = {}
+    if (p.budgets && typeof p.budgets === 'object')
+      for (const [k, v] of Object.entries(p.budgets)) if (Number.isSafeInteger(v) && (v as number) > 0) budgets[k] = v as number
+    return { transactions: txs, categories: cats, budgets }
+  } catch {
+    return fresh
+  }
+}
+
+export function saveData(storage: Pick<Storage, 'setItem'>, data: AppData) {
+  try {
+    storage.setItem(STORAGE_KEY, JSON.stringify(data))
+  } catch {
+    /* storage full / unavailable */
+  }
+}
