@@ -0,0 +1,36 @@
+export interface LogEntry {
+  id: string
+  task: string
+  finishedAt: number
+  minutes: number
+}
+
+export function dayKey(ts: number): string {
+  const d = new Date(ts)
+  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`
+}
+
+/** Keep only entries finished on the same local day as `now`, newest first. */
+export function todaysEntries(entries: LogEntry[], now: number): LogEntry[] {
+  const today = dayKey(now)
+  return entries.filter((e) => dayKey(e.finishedAt) === today).sort((a, b) => b.finishedAt - a.finishedAt)
+}
+
+export function addEntry(entries: LogEntry[], entry: Omit<LogEntry, 'id'>, now: number): LogEntry[] {
+  const id = `${entry.finishedAt}-${Math.random().toString(36).slice(2, 8)}`
+  return todaysEntries([...entries, { ...entry, id }], now)
+}
+
+export function sanitizeLog(value: unknown, now: number): LogEntry[] {
+  if (!Array.isArray(value)) return []
+  const valid = value.filter(
+    (e): e is LogEntry =>
+      !!e && typeof e === 'object' && typeof e.id === 'string' && typeof e.task === 'string' &&
+      typeof e.finishedAt === 'number' && typeof e.minutes === 'number',
+  )
+  return todaysEntries(valid, now)
+}
+
+export function formatClock(ts: number): string {
+  return new Date(ts).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
+}
