@@ -0,0 +1,101 @@
+import { describe, expect, it } from 'vitest'
+import * as T from './timer'
+
+const S = T.DEFAULT_SETTINGS
+const T0 = 1_000_000
+
+describe('timer', () => {
+  it('starts with 25 min focus', () => {
+    const st = T.initialState(S)
+    expect(st.remaining).toBe(25 * 60_000)
+    expect(T.formatTime(st.remaining)).toBe('25:00')
+  })
+  it('is timestamp based: remaining derives from now, not tick count', () => {
+    const st = T.start(T.initialState(S), T0)
+    expect(T.remainingMs(st, T0 + 10 * 60_000)).toBe(15 * 60_000)
+    expect(T.titleFor(st, T0 + 12 * 60_000 + 56_000)).toBe('12:04 - Focus')
+  })
+  it('pause freezes and resume continues', () => {
+    let st = T.start(T.initialState(S), T0)
+    st = T.pause(st, T0 + 60_000)
+    expect(T.remainingMs(st, T0 + 999_999)).toBe(24 * 60_000)
+    st = T.start(st, T0 + 500_000)
+    expect(T.remainingMs(st, T0 + 500_000 + 1000)).toBe(24 * 60_000 - 1000)
+  })
+  it('reset restores full phase duration and stops', () => {
+    let st = T.start(T.initialState(S), T0)
+    st = T.reset(st, S)
+    expect(st.endAt).toBeNull()
+    expect(st.remaining).toBe(25 * 60_000)
+  })
+  it('does not finish early, finishes at endAt', () => {
+    const st = T.start(T.initialState(S), T0)
+    expect(T.tick(st, S, T0 + 25 * 60_000 - 1).finished).toBeNull()
+    const r = T.tick(st, S, T0 + 25 * 60_000)
+    expect(r.finished).toBe('focus')
+    expect(r.state.phase).toBe('short')
+    expect(r.state.endAt).toBeNull()
+    expect(r.state.cycle).toBe(1)
+  })
+  it('long break after 4 focus sessions, then cycle resets', () => {
+    let st = T.initialState(S)
+    const phases: string[] = []
+    for (let i = 0; i < 9; i++) {
+      st = T.start(st, T0)
+      st = T.tick(st, S, T0 + 90 * 60_000).state
+      phases.push(st.phase)
+    }
+    expect(phases).toEqual(['short', 'focus', 'short', 'focus', 'short', 'focus', 'long', 'focus', 'short'])
+  })
+  it('dots track the cycle', () => {
+    let st = T.initialState(S)
+    expect(T.filledDots(st)).toBe(0)
+    st = T.tick(T.start(st, 0), S, 1e9).state
+    expect(T.filledDots(st)).toBe(1)
+    st = { ...st, cycle: 4, phase: 'long' }
+    expect(T.filledDots(st)).toBe(4)
+    st = T.tick(T.start(st, 0), S, 1e9).state
+    expect(T.filledDots(st)).toBe(0)
+  })
+  it('skip moves on without counting a focus session', () => {
+    const st = T.skip(T.initialState(S), S)
+    expect(st.phase).toBe('short')
+    expect(st.cycle).toBe(0)
+    expect(T.skip(st, S).phase).toBe('focus')
+  })
+  it('uses custom durations', () => {
+    const s = { ...S, short: 7 }
+    const st = T.tick(T.start(T.initialState(s), 0), s, 1e9).state
+    expect(st.remaining).toBe(7 * 60_000)
+  })
+  it('formats time rounding up', () => {
+    expect(T.formatTime(1)).toBe('00:01')
+    expect(T.formatTime(0)).toBe('00:00')
+    expect(T.formatTime(90 * 60_000)).toBe('90:00')
+  })
+})
+
+describe('validation and storage', () => {
+  it('parseMinutes accepts 1-90 integers only', () => {
+    expect(T.parseMinutes('1')).toBe(1)
+    expect(T.parseMinutes('90')).toBe(90)
+    expect(T.parseMinutes(' 25 ')).toBe(25)
+    for (const bad of ['0', '91', '', '-5', '2.5', 'abc', '1e1']) expect(T.parseMinutes(bad)).toBeNull()
+  })
+  it('sanitizeSettings falls back on bad data', () => {
+    expect(T.sanitizeSettings(null)).toEqual(S)
+    expect(T.sanitizeSettings({ focus: 50, short: 0, long: 'x', muted: true })).toEqual({ ...S, focus: 50, muted: true })
+  })
+  it('filters only entries from today', () => {
+    const now = new Date(2025, 5, 10, 12).getTime()
+    const log = [
+      { id: 'a', label: '', finishedAt: new Date(2025, 5, 9, 23, 59).getTime() },
+      { id: 'b', label: 'x', finishedAt: new Date(2025, 5, 10, 0, 1).getTime() },
+    ]
+    expect(T.todaysEntries(log, now).map((e) => e.id)).toEqual(['b'])
+  })
+  it('sanitizeLog drops junk', () => {
+    expect(T.sanitizeLog('x')).toEqual([])
+    expect(T.sanitizeLog([{ id: 'a', label: '', finishedAt: 1 }, { nope: 1 }, null])).toHaveLength(1)
+  })
+})
diff --git a/src/timer.ts b/src/timer.ts
new file mode 100644
index 0000000..ce2ee7b
--- /dev/null
+++ b/src/timer.ts
@@ -0,0 +1,116 @@
+export type Phase = 'focus' | 'short' | 'long'
+export interface Settings { focus: number; short: number; long: number; muted: boolean }
+export interface LogEntry { id: string; label: string; finishedAt: number }
+
+export const DEFAULT_SETTINGS: Settings = { focus: 25, short: 5, long: 15, muted: false }
+export const CYCLE = 4
+export const PHASE_NAME: Record<Phase, string> = { focus: 'Focus', short: 'Short break', long: 'Long break' }
+
+export interface TimerState {
+  phase: Phase
+  /** timestamp (ms) when the running phase ends; null while paused/idle */
+  endAt: number | null
+  /** ms left while paused/idle */
+  remaining: number
+  /** focus sessions completed in the current cycle (0-3, or 4 during the long break) */
+  cycle: number
+}
+
+export const phaseMs = (s: Settings, p: Phase) => s[p] * 60_000
+
+export function initialState(s: Settings): TimerState {
+  return { phase: 'focus', endAt: null, remaining: phaseMs(s, 'focus'), cycle: 0 }
+}
+
+export const isRunning = (st: TimerState) => st.endAt !== null
+
+export function remainingMs(st: TimerState, now: number) {
+  return st.endAt === null ? st.remaining : Math.max(0, st.endAt - now)
+}
+
+export function start(st: TimerState, now: number): TimerState {
+  if (isRunning(st)) return st
+  return { ...st, endAt: now + st.remaining }
+}
+
+export function pause(st: TimerState, now: number): TimerState {
+  if (!isRunning(st)) return st
+  return { ...st, endAt: null, remaining: remainingMs(st, now) }
+}
+
+export function reset(st: TimerState, s: Settings): TimerState {
+  return { ...st, endAt: null, remaining: phaseMs(s, st.phase) }
+}
+
+/** Move to the next phase (stopped, ready to start). */
+export function advance(st: TimerState, s: Settings, completedFocus: boolean): TimerState {
+  if (st.phase === 'focus') {
+    const cycle = completedFocus ? st.cycle + 1 : st.cycle
+    const phase: Phase = cycle >= CYCLE ? 'long' : 'short'
+    return { phase, endAt: null, remaining: phaseMs(s, phase), cycle }
+  }
+  // after a break go back to focus; after the long break the cycle starts over
+  const cycle = st.phase === 'long' ? 0 : st.cycle
+  return { phase: 'focus', endAt: null, remaining: phaseMs(s, 'focus'), cycle }
+}
+
+export function skip(st: TimerState, s: Settings): TimerState {
+  return advance(st, s, false)
+}
+
+/** If the running phase has ended, move on. Returns the finished phase when it ended. */
+export function tick(st: TimerState, s: Settings, now: number): { state: TimerState; finished: Phase | null } {
+  if (st.endAt === null || now < st.endAt) return { state: st, finished: null }
+  return { state: advance(st, s, true), finished: st.phase }
+}
+
+/** Dots filled toward the long break. */
+export const filledDots = (st: TimerState) => Math.min(st.cycle, CYCLE)
+
+export function formatTime(ms: number) {
+  const total = Math.ceil(ms / 1000)
+  const m = Math.floor(total / 60)
+  const sec = total % 60
+  return `${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}`
+}
+
+export const titleFor = (st: TimerState, now: number) =>
+  `${formatTime(remainingMs(st, now))} - ${PHASE_NAME[st.phase]}`
+
+/** Returns the whole-minute value if valid (integer 1-90), else null. */
+export function parseMinutes(raw: string): number | null {
+  const t = raw.trim()
+  if (!/^\d+$/.test(t)) return null
+  const n = Number(t)
+  return n >= 1 && n <= 90 ? n : null
+}
+
+export const dayKey = (ts: number) => {
+  const d = new Date(ts)
+  return `${d.getFullYear()}-${d.getMonth() + 1}-${d.getDate()}`
+}
+
+export const todaysEntries = (log: LogEntry[], now: number) =>
+  log.filter((e) => dayKey(e.finishedAt) === dayKey(now))
+
+/** Settings loader tolerant of corrupt / partial data. */
+export function sanitizeSettings(raw: unknown): Settings {
+  const out = { ...DEFAULT_SETTINGS }
+  if (raw && typeof raw === 'object') {
+    const r = raw as Record<string, unknown>
+    for (const k of ['focus', 'short', 'long'] as const) {
+      const v = r[k]
+      if (typeof v === 'number' && Number.isInteger(v) && v >= 1 && v <= 90) out[k] = v
+    }
+    if (typeof r.muted === 'boolean') out.muted = r.muted
+  }
+  return out
+}
+
+export function sanitizeLog(raw: unknown): LogEntry[] {
+  if (!Array.isArray(raw)) return []
+  return raw.filter(
+    (e): e is LogEntry =>
+      !!e && typeof e.id === 'string' && typeof e.label === 'string' && typeof e.finishedAt === 'number',
+  )
+}
