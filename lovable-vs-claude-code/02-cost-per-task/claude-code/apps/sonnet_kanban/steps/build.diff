+
+        {filtering && totalVisible === 0 && totalCards > 0 && (
+          <div data-testid="no-results" className="mb-4 rounded-lg border border-dashed border-slate-300 bg-white p-6 text-center text-slate-600">
+            <p className="font-medium">No cards match your search or filter.</p>
+            <button onClick={() => setFilters({ query: '', priority: 'all' })} className="mt-2 text-blue-700 underline">Clear filters</button>
+          </div>
+        )}
+
+        <div className="grid grid-cols-1 items-start gap-4 md:grid-cols-3">
+          {COLUMN_IDS.map((col) => {
+            const cards = visible[col]
+            const total = board.columns[col].length
+            const over = col === 'doing' && total > WIP_LIMIT
+            const isDropCol = drop?.col === col
+            return (
+              <section
+                key={col}
+                data-column={col}
+                aria-label={COLUMN_TITLES[col]}
+                className={`rounded-xl border bg-slate-50 p-3 transition-colors ${
+                  over ? 'border-amber-400 bg-amber-50' : 'border-slate-200'
+                } ${isDropCol ? 'ring-2 ring-blue-400' : ''}`}
+              >
+                <div className="mb-2 flex items-center justify-between">
+                  <h2 className="flex items-center gap-2 font-semibold">
+                    {COLUMN_TITLES[col]}
+                    <span
+                      data-testid={`count-${col}`}
+                      aria-label={`${total} cards`}
+                      className={`rounded-full px-2 py-0.5 text-xs font-medium ${over ? 'bg-amber-500 text-white' : 'bg-slate-200 text-slate-700'}`}
+                    >
+                      {filtering ? `${cards.length} of ${total}` : total}
+                      {col === 'doing' ? ` / ${WIP_LIMIT}` : ''}
+                    </span>
+                  </h2>
+                  <button
+                    onClick={() => setDialog({ kind: 'card', column: col })}
+                    className="rounded-md px-2 py-1 text-sm font-medium text-blue-700 hover:bg-blue-50"
+                    aria-label={`Add card to ${COLUMN_TITLES[col]}`}
+                  >
+                    + Add
+                  </button>
+                </div>
+
+                {col === 'doing' && wipExceeded(board) && (
+                  <div role="alert" data-testid="wip-warning" className="mb-2 rounded-md border border-amber-400 bg-amber-100 px-3 py-2 text-sm text-amber-900">
+                    ⚠ WIP limit exceeded: {total} cards in Doing (limit {WIP_LIMIT}). Finish something before starting more.
+                  </div>
+                )}
+
+                <ul className="flex min-h-12 flex-col gap-2">
+                  {cards.map((card) => (
+                    <li key={card.id} className="contents">
+                      {isDropCol && drop.beforeId === card.id && <DropLine />}
+                      <CardView
+                        card={card}
+                        column={col}
+                        overdue={isOverdue(card, col, today)}
+                        dragging={drag?.id === card.id}
+                        onPointerDown={(e) => startPointer(e, card)}
+                        onEdit={() => setDialog({ kind: 'card', column: col, card })}
+                        onDelete={() => setDialog({ kind: 'delete', card })}
+                        onMove={(kind, step) => keyboardMove(card.id, kind, step)}
+                      />
+                    </li>
+                  ))}
+                  {isDropCol && drop.beforeId === null && <li className="contents"><DropLine /></li>}
+                </ul>
+
+                {cards.length === 0 && (
+                  <p data-testid={`empty-${col}`} className="rounded-lg border border-dashed border-slate-300 px-3 py-6 text-center text-sm text-slate-500">
+                    {total === 0 ? (col === 'todo' ? 'Nothing to do yet. Add a card to get started.' : col === 'doing' ? 'Nothing in progress. Drag a card here to start.' : 'Nothing done yet.') : 'No matching cards in this column.'}
+                  </p>
+                )}
+              </section>
+            )
+          })}
+        </div>
+      </main>
+
+      {drag && draggedCard && (
+        <div
+          aria-hidden
+          className="pointer-events-none fixed z-50 rotate-2 rounded-lg border border-blue-400 bg-white p-3 opacity-90 shadow-xl"
+          style={{ left: drag.x - drag.dx, top: drag.y - drag.dy, width: drag.w }}
+        >
+          <p className="font-medium">{draggedCard.title}</p>
+        </div>
+      )}
+
+      <div role="status" aria-live="polite" className="sr-only">{announcement}</div>
+
+      {dialog?.kind === 'card' && (
+        <CardDialog
+          card={dialog.card}
+          onCancel={() => setDialog(null)}
+          onSave={(input) => saveCard(dialog.column, dialog.card, input)}
+        />
+      )}
+      {dialog?.kind === 'delete' && (
+        <ConfirmDialog
+          title="Delete this card?"
+          message={`“${dialog.card.title}” will be permanently deleted.`}
+          confirmLabel="Delete"
+          onCancel={() => setDialog(null)}
+          onConfirm={() => confirmDelete(dialog.card)}
+        />
+      )}
+    </div>
+  )
+}
+
+function DropLine() {
+  return <div aria-hidden className="h-1 rounded bg-blue-500" data-testid="drop-line" />
+}
+
+interface CardViewProps {
+  card: Card
+  column: ColumnId
+  overdue: boolean
+  dragging: boolean
+  onPointerDown: (e: React.PointerEvent) => void
+  onEdit: () => void
+  onDelete: () => void
+  onMove: (kind: 'col' | 'row', step: -1 | 1) => void
+}
+
+function CardView({ card, column, overdue, dragging, onPointerDown, onEdit, onDelete, onMove }: CardViewProps) {
+  const idx = COLUMN_IDS.indexOf(column)
+  const prev = COLUMN_IDS[idx - 1], next = COLUMN_IDS[idx + 1]
+  const onKeyDown = (e: React.KeyboardEvent) => {
+    if (e.target !== e.currentTarget || !e.altKey) return
+    const map: Record<string, ['col' | 'row', -1 | 1]> = {
+      ArrowLeft: ['col', -1], ArrowRight: ['col', 1], ArrowUp: ['row', -1], ArrowDown: ['row', 1],
+    }
+    const m = map[e.key]
+    if (m) { e.preventDefault(); onMove(m[0], m[1]) }
+  }
+  const btn = 'rounded px-1.5 py-1 text-xs text-slate-600 hover:bg-slate-100 focus-visible:outline-2'
+  return (
+    <article
+      data-card-id={card.id}
+      data-overdue={overdue || undefined}
+      tabIndex={0}
+      aria-label={`${card.title}, ${PRIORITY_LABELS[card.priority]} priority${overdue ? ', overdue' : ''}`}
+      onPointerDown={onPointerDown}
+      onKeyDown={onKeyDown}
+      className={`group cursor-grab select-none rounded-lg border bg-white p-3 shadow-sm focus-visible:outline-2 focus-visible:outline-blue-500 ${
+        overdue ? 'border-rose-400 bg-rose-50 ring-1 ring-rose-300' : 'border-slate-200'
+      } ${dragging ? 'opacity-40' : ''}`}
+    >
+      <div className="flex items-start gap-2">
+        <span data-handle aria-hidden className="-ml-1 mt-0.5 cursor-grab touch-none px-1 text-lg leading-none text-slate-400" title="Drag to move">⠿</span>
+        <div className="min-w-0 flex-1">
+          <p className="break-words font-medium">{card.title}</p>
+          {card.description && <p className="mt-1 line-clamp-3 break-words text-sm text-slate-600">{card.description}</p>}
+          <div className="mt-2 flex flex-wrap items-center gap-2 text-xs">
+            <span data-testid="priority" className={`rounded-full px-2 py-0.5 font-medium ring-1 ${PRIORITY_STYLES[card.priority]}`}>
+              {PRIORITY_LABELS[card.priority]}
+            </span>
+            {card.dueDate && (
+              <span className={overdue ? 'font-semibold text-rose-700' : 'text-slate-500'}>
+                Due {card.dueDate}
+              </span>
+            )}
+            {overdue && <span data-testid="overdue-badge" className="rounded bg-rose-600 px-1.5 py-0.5 font-semibold text-white">Overdue</span>}
+          </div>
+        </div>
+      </div>
+      <div className="mt-2 flex items-center justify-between border-t border-slate-100 pt-2">
+        <div className="flex gap-1">
+          {prev && <button className={btn} onClick={() => onMove('col', -1)} aria-label={`Move “${card.title}” to ${COLUMN_TITLES[prev]}`}>← {COLUMN_TITLES[prev]}</button>}
+          {next && <button className={btn} onClick={() => onMove('col', 1)} aria-label={`Move “${card.title}” to ${COLUMN_TITLES[next]}`}>{COLUMN_TITLES[next]} →</button>}
+        </div>
+        <div className="flex gap-1">
+          <button className={btn} onClick={onEdit} aria-label={`Edit “${card.title}”`}>Edit</button>
+          <button className={`${btn} text-rose-700`} onClick={onDelete} aria-label={`Delete “${card.title}”`}>Delete</button>
+        </div>
+      </div>
+    </article>
+  )
 }
diff --git a/src/board.test.ts b/src/board.test.ts
new file mode 100644
index 0000000..78393af
--- /dev/null
+++ b/src/board.test.ts
@@ -0,0 +1,141 @@
+import { describe, expect, it } from 'vitest'
+import {
+  addCard, deleteCard, emptyBoard, findColumn, isOverdue, loadBoard, matchesFilters, moveCard,
+  moveCardByStep, parseBoard, reorderByStep, saveBoard, todayString, updateCard, wipExceeded,
+  type Board, type CardInput,
+} from './board'
+
+const input = (title: string, extra: Partial<CardInput> = {}): CardInput =>
+  ({ title, description: '', dueDate: '', priority: 'medium', ...extra })
+
+function sample(): Board {
+  let b = emptyBoard()
+  b = addCard(b, 'todo', input('A'), 'a')
+  b = addCard(b, 'todo', input('B'), 'b')
+  b = addCard(b, 'todo', input('C'), 'c')
+  b = addCard(b, 'doing', input('D'), 'd')
+  return b
+}
+
+describe('cards', () => {
+  it('adds, trims, edits and deletes', () => {
+    let b = addCard(emptyBoard(), 'todo', input('  Hi  ', { description: ' x ' }), 'a')
+    expect(b.cards.a.title).toBe('Hi')
+    expect(b.cards.a.description).toBe('x')
+    b = updateCard(b, 'a', input('New', { priority: 'high', dueDate: '2030-01-01' }))
+    expect(b.cards.a).toMatchObject({ title: 'New', priority: 'high', dueDate: '2030-01-01' })
+    b = deleteCard(b, 'a')
+    expect(b.cards.a).toBeUndefined()
+    expect(b.columns.todo).toEqual([])
+  })
+  it('ignores unknown ids', () => {
+    const b = sample()
+    expect(deleteCard(b, 'zz')).toBe(b)
+    expect(updateCard(b, 'zz', input('x'))).toBe(b)
+  })
+})
+
+describe('moving', () => {
+  it('reorders within a column', () => {
+    expect(moveCard(sample(), 'c', 'todo', 'a').columns.todo).toEqual(['c', 'a', 'b'])
+    expect(moveCard(sample(), 'a', 'todo', null).columns.todo).toEqual(['b', 'c', 'a'])
+    expect(moveCard(sample(), 'a', 'todo', 'c').columns.todo).toEqual(['b', 'a', 'c'])
+  })
+  it('moves across columns at a position', () => {
+    const b = moveCard(sample(), 'b', 'doing', 'd')
+    expect(b.columns.todo).toEqual(['a', 'c'])
+    expect(b.columns.doing).toEqual(['b', 'd'])
+  })
+  it('appends to an empty column', () => {
+    expect(moveCard(sample(), 'a', 'done').columns.done).toEqual(['a'])
+  })
+  it('steps between columns, stopping at the edges', () => {
+    let b = moveCardByStep(sample(), 'a', 1)
+    expect(findColumn(b, 'a')).toBe('doing')
+    expect(b.columns.doing).toEqual(['d', 'a'])
+    b = moveCardByStep(b, 'a', 1)
+    expect(findColumn(b, 'a')).toBe('done')
+    expect(moveCardByStep(b, 'a', 1)).toBe(b)
+    expect(moveCardByStep(sample(), 'a', -1).columns.todo).toEqual(['a', 'b', 'c'])
+  })
+  it('reorders by step', () => {
+    expect(reorderByStep(sample(), 'b', -1).columns.todo).toEqual(['b', 'a', 'c'])
+    expect(reorderByStep(sample(), 'b', 1).columns.todo).toEqual(['a', 'c', 'b'])
+    const b = sample()
+    expect(reorderByStep(b, 'a', -1)).toBe(b)
+  })
+  it('never duplicates a card', () => {
+    const b = moveCard(moveCard(sample(), 'a', 'doing'), 'a', 'done')
+    const all = [...b.columns.todo, ...b.columns.doing, ...b.columns.done]
+    expect(all.filter((x) => x === 'a')).toHaveLength(1)
+  })
+})
+
+describe('wip limit', () => {
+  it('is exceeded only above 3 in Doing', () => {
+    let b = emptyBoard()
+    for (let i = 0; i < 3; i++) b = addCard(b, 'doing', input('x' + i))
+    expect(wipExceeded(b)).toBe(false)
+    b = addCard(b, 'doing', input('x4'))
+    expect(wipExceeded(b)).toBe(true)
+  })
+})
+
+describe('filters', () => {
+  const card = { id: '1', title: 'Buy Milk', description: 'from the shop', dueDate: '', priority: 'low' as const }
+  it('searches title and description case-insensitively', () => {
+    expect(matchesFilters(card, { query: 'milk', priority: 'all' })).toBe(true)
+    expect(matchesFilters(card, { query: 'SHOP', priority: 'all' })).toBe(true)
+    expect(matchesFilters(card, { query: 'bread', priority: 'all' })).toBe(false)
+    expect(matchesFilters(card, { query: '  ', priority: 'all' })).toBe(true)
+  })
+  it('filters by priority and combines with search', () => {
+    expect(matchesFilters(card, { query: '', priority: 'high' })).toBe(false)
+    expect(matchesFilters(card, { query: 'milk', priority: 'low' })).toBe(true)
+    expect(matchesFilters(card, { query: 'bread', priority: 'low' })).toBe(false)
+  })
+})
+
+describe('overdue', () => {
+  const c = (dueDate: string) => ({ id: '1', title: 't', description: '', dueDate, priority: 'low' as const })
+  it('flags past due cards not in Done', () => {
+    expect(isOverdue(c('2020-01-01'), 'todo', '2026-01-02')).toBe(true)
+    expect(isOverdue(c('2020-01-01'), 'doing', '2026-01-02')).toBe(true)
+    expect(isOverdue(c('2020-01-01'), 'done', '2026-01-02')).toBe(false)
+  })
+  it('does not flag today, future or no date', () => {
+    expect(isOverdue(c('2026-01-02'), 'todo', '2026-01-02')).toBe(false)
+    expect(isOverdue(c('2026-01-03'), 'todo', '2026-01-02')).toBe(false)
+    expect(isOverdue(c(''), 'todo', '2026-01-02')).toBe(false)
+  })
+  it('formats local dates', () => {
+    expect(todayString(new Date(2026, 0, 5))).toBe('2026-01-05')
+  })
+})
+
+describe('persistence', () => {
+  it('round-trips through storage', () => {
+    const mem = new Map<string, string>()
+    const storage = { getItem: (k: string) => mem.get(k) ?? null, setItem: (k: string, v: string) => void mem.set(k, v) }
+    const b = moveCard(sample(), 'a', 'done')
+    saveBoard(b, storage)
+    expect(loadBoard(storage)).toEqual(b)
+  })
+  it('survives corrupt or hostile data', () => {
+    expect(parseBoard('not json')).toEqual(emptyBoard())
+    expect(parseBoard(null)).toEqual(emptyBoard())
+    const raw = JSON.stringify({
+      columns: { todo: ['x', 'x', 5] },
+      cards: { x: { title: 'T', priority: 'bogus', dueDate: 'nope' } },
+    })
+    expect(parseBoard(raw)).toEqual({
+      cards: { x: { id: 'x', title: 'T', description: '', dueDate: '', priority: 'medium' } },
+      columns: { todo: ['x'], doing: [], done: [] },
+    })
+  })
+  it('does not throw if storage throws', () => {
+    const bad = { getItem: () => { throw new Error('no') }, setItem: () => { throw new Error('no') } }
+    expect(loadBoard(bad)).toEqual(emptyBoard())
+    expect(() => saveBoard(emptyBoard(), bad)).not.toThrow()
+  })
+})
diff --git a/src/board.ts b/src/board.ts
new file mode 100644
index 0000000..28499dd
--- /dev/null
+++ b/src/board.ts
@@ -0,0 +1,175 @@
+export type ColumnId = 'todo' | 'doing' | 'done'
+export type Priority = 'low' | 'medium' | 'high'
+
+export interface Card {
+  id: string
+  title: string
+  description: string
+  dueDate: string // YYYY-MM-DD or ''
+  priority: Priority
+}
+
+export interface Board {
+  cards: Record<string, Card>
+  columns: Record<ColumnId, string[]>
+}
+
+export const COLUMN_IDS: ColumnId[] = ['todo', 'doing', 'done']
+export const COLUMN_TITLES: Record<ColumnId, string> = { todo: 'To do', doing: 'Doing', done: 'Done' }
+export const PRIORITIES: Priority[] = ['low', 'medium', 'high']
+export const PRIORITY_LABELS: Record<Priority, string> = { low: 'Low', medium: 'Medium', high: 'High' }
+export const WIP_LIMIT = 3
+export const STORAGE_KEY = 'kanban-board-v1'
+
+export type CardInput = Pick<Card, 'title' | 'description' | 'dueDate' | 'priority'>
+
+export const emptyBoard = (): Board => ({ cards: {}, columns: { todo: [], doing: [], done: [] } })
+
+let counter = 0
+export const newId = () => `c${Date.now().toString(36)}${(counter++).toString(36)}${Math.random().toString(36).slice(2, 6)}`
+
+export function todayString(d = new Date()): string {
+  const p = (n: number) => String(n).padStart(2, '0')
+  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`
+}
+
+export function findColumn(board: Board, id: string): ColumnId | null {
+  return COLUMN_IDS.find((c) => board.columns[c].includes(id)) ?? null
+}
+
+function clean(i: CardInput): CardInput {
+  return { title: i.title.trim(), description: i.description.trim(), dueDate: i.dueDate, priority: i.priority }
+}
+
+export function addCard(board: Board, column: ColumnId, input: CardInput, id = newId()): Board {
+  const card: Card = { id, ...clean(input) }
+  return {
+    cards: { ...board.cards, [id]: card },
+    columns: { ...board.columns, [column]: [...board.columns[column], id] },
+  }
+}
+
+export function updateCard(board: Board, id: string, input: CardInput): Board {
+  if (!board.cards[id]) return board
+  return { ...board, cards: { ...board.cards, [id]: { id, ...clean(input) } } }
+}
+
+export function deleteCard(board: Board, id: string): Board {
+  if (!board.cards[id]) return board
+  const cards = { ...board.cards }
+  delete cards[id]
+  const columns = { ...board.columns }
+  for (const c of COLUMN_IDS) columns[c] = columns[c].filter((x) => x !== id)
+  return { cards, columns }
+}
+
+/** Move a card to `to`, placed before card `beforeId` (or at the end if null/unknown). */
+export function moveCard(board: Board, id: string, to: ColumnId, beforeId: string | null = null): Board {
+  if (!board.cards[id] || beforeId === id) return board
+  const columns = { ...board.columns }
+  for (const c of COLUMN_IDS) columns[c] = columns[c].filter((x) => x !== id)
+  const target = [...columns[to]]
+  const idx = beforeId ? target.indexOf(beforeId) : -1
+  if (idx === -1) target.push(id)
+  else target.splice(idx, 0, id)
+  columns[to] = target
+  return { ...board, columns }
+}
+
+/** Move a card one column left (-1) or right (+1), appending to the end. */
+export function moveCardByStep(board: Board, id: string, step: -1 | 1): Board {
+  const from = findColumn(board, id)
+  if (!from) return board
+  const next = COLUMN_IDS[COLUMN_IDS.indexOf(from) + step]
+  return next ? moveCard(board, id, next) : board
+}
+
+/** Move a card one position up (-1) or down (+1) within its column. */
+export function reorderByStep(board: Board, id: string, step: -1 | 1): Board {
+  const col = findColumn(board, id)
+  if (!col) return board
+  const list = [...board.columns[col]]
+  const i = list.indexOf(id)
+  const j = i + step
+  if (j < 0 || j >= list.length) return board
+  ;[list[i], list[j]] = [list[j], list[i]]
+  return { ...board, columns: { ...board.columns, [col]: list } }
+}
+
+export interface Filters {
+  query: string
+  priority: Priority | 'all'
+}
+
+export function matchesFilters(card: Card, f: Filters): boolean {
+  if (f.priority !== 'all' && card.priority !== f.priority) return false
+  const q = f.query.trim().toLowerCase()
+  if (!q) return true
+  return card.title.toLowerCase().includes(q) || card.description.toLowerCase().includes(q)
+}
+
+export const isFiltering = (f: Filters) => f.query.trim() !== '' || f.priority !== 'all'
+
+export function isOverdue(card: Card, column: ColumnId, today = todayString()): boolean {
+  return column !== 'done' && card.dueDate !== '' && card.dueDate < today
+}
+
+export const wipExceeded = (board: Board) => board.columns.doing.length > WIP_LIMIT
+
+const isPriority = (p: unknown): p is Priority => p === 'low' || p === 'medium' || p === 'high'
+
+/** Parse untrusted stored data into a valid board (drops anything malformed). */
+export function parseBoard(raw: string | null): Board {
+  if (!raw) return emptyBoard()
+  try {
+    const data = JSON.parse(raw)
+    const board = emptyBoard()
+    const seen = new Set<string>()
+    for (const c of COLUMN_IDS) {
+      const ids = data?.columns?.[c]
+      if (!Array.isArray(ids)) continue
+      for (const id of ids) {
+        const card = typeof id === 'string' ? data.cards?.[id] : null
+        if (typeof id !== 'string' || seen.has(id) || !card || typeof card.title !== 'string') continue
+        seen.add(id)
+        board.cards[id] = {
+          id,
+          title: card.title,
+          description: typeof card.description === 'string' ? card.description : '',
+          dueDate: typeof card.dueDate === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(card.dueDate) ? card.dueDate : '',
+          priority: isPriority(card.priority) ? card.priority : 'medium',
+        }
+        board.columns[c].push(id)
+      }
+    }
+    return board
+  } catch {
+    return emptyBoard()
+  }
+}
+
+type StorageLike = Pick<Storage, 'getItem' | 'setItem'>
+
+function safeStorage(): Storage | undefined {
+  try {
+    return globalThis.localStorage
+  } catch {
+    return undefined
+  }
+}
+
+export function loadBoard(storage: StorageLike | undefined = safeStorage()): Board {
+  try {
+    return parseBoard(storage?.getItem(STORAGE_KEY) ?? null)
+  } catch {
+    return emptyBoard()
+  }
+}
+
+export function saveBoard(board: Board, storage: StorageLike | undefined = safeStorage()): void {
+  try {
+    storage?.setItem(STORAGE_KEY, JSON.stringify(board))
+  } catch {
+    /* quota or privacy mode: ignore */
+  }
+}
diff --git a/src/dialogs.tsx b/src/dialogs.tsx
