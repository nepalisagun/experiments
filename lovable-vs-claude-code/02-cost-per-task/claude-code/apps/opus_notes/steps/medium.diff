+import { describe, expect, it } from 'vitest'
+import {
+  applySuggestion,
+  codeMask,
+  countTags,
+  extractTags,
+  hasTag,
+  normalizeTag,
+  renameTag,
+  suggestTags,
+  tagQueryAt,
+} from './tags'
+
+describe('extractTags', () => {
+  it('finds tags anywhere in the text, lowercased and unique', () => {
+    expect(extractTags('#Work stuff and #ideas, also #work again.\n- item #to-do')).toEqual(['work', 'ideas', 'to-do'])
+  })
+
+  it('accepts tags at line start, after punctuation and with unicode', () => {
+    expect(extractTags('#start\n(#paren) "#quoted" #zażółć #q3_goals')).toEqual([
+      'start',
+      'paren',
+      'quoted',
+      'zażółć',
+      'q3_goals',
+    ])
+  })
+
+  it('ignores headings, numbers and hashes glued to words', () => {
+    expect(extractTags('# Heading\n## Sub\nissue #123 C# page#anchor a&#39;b ##double')).toEqual([])
+  })
+
+  it('trims trailing hyphens and punctuation', () => {
+    expect(extractTags('#done. #wip- #a-b-c!')).toEqual(['done', 'wip', 'a-b-c'])
+  })
+
+  it('ignores code, link targets, URLs and escaped hashes', () => {
+    const md = [
+      'Use `#notatag` inline',
+      '```',
+      '#also-not',
+      '```',
+      '[link](#anchor) and [#linktext](https://x.com)',
+      'https://example.com/page#frag',
+      '\\#escaped',
+      '#real',
+    ].join('\n')
+    expect(extractTags(md)).toEqual(['linktext', 'real'])
+  })
+})
+
+describe('codeMask', () => {
+  it('keeps the same length and blanks code', () => {
+    const md = 'a `#x` b\n```\n#y\n```\n#z'
+    const mask = codeMask(md)
+    expect(mask).toHaveLength(md.length)
+    expect(mask).not.toContain('#x')
+    expect(mask).not.toContain('#y')
+    expect(mask).toContain('#z')
+  })
+})
+
+describe('countTags', () => {
+  it('counts notes per tag (not occurrences), sorted alphabetically', () => {
+    expect(countTags(['#b #a #a', '#a', 'none', '#c `#b`'])).toEqual([
+      { tag: 'a', count: 2 },
+      { tag: 'b', count: 1 },
+      { tag: 'c', count: 1 },
+    ])
+  })
+  it('hasTag is case-insensitive', () => {
+    expect(hasTag('Hello #Work', 'work')).toBe(true)
+    expect(hasTag('Hello #Workshop', 'work')).toBe(false)
+  })
+})
+
+describe('normalizeTag', () => {
+  it('cleans and validates names', () => {
+    expect(normalizeTag(' #Work ')).toBe('work')
+    expect(normalizeTag('to-do')).toBe('to-do')
+    expect(normalizeTag('')).toBeNull()
+    expect(normalizeTag('#')).toBeNull()
+    expect(normalizeTag('two words')).toBeNull()
+    expect(normalizeTag('123')).toBeNull()
+    expect(normalizeTag('bad!')).toBeNull()
+    expect(normalizeTag('-x')).toBeNull()
+  })
+})
+
+describe('renameTag', () => {
+  it('renames every occurrence, case-insensitively', () => {
+    expect(renameTag('#work and #Work. (#WORK)', 'work', 'job')).toBe('#job and #job. (#job)')
+  })
+  it('only renames whole tags', () => {
+    expect(renameTag('#work #workshop #work-items #homework', 'work', 'job')).toBe(
+      '#job #workshop #work-items #homework',
+    )
+  })
+  it('leaves code, links and URLs alone', () => {
+    const md = '`#work` [x](#work) https://a.com/#work\n```\n#work\n```\n#work'
+    expect(renameTag(md, 'work', 'job')).toBe('`#work` [x](#work) https://a.com/#work\n```\n#work\n```\n#job')
+  })
+  it('normalizes the new name and rejects invalid ones', () => {
+    expect(renameTag('#a', 'a', '#New-Name')).toBe('#new-name')
+    expect(renameTag('#a', 'a', 'not valid')).toBe('#a')
+    expect(renameTag('no tags', 'a', 'b')).toBe('no tags')
+  })
+  it('can merge into an existing tag', () => {
+    expect(extractTags(renameTag('#a #b', 'a', 'b'))).toEqual(['b'])
+  })
+})
+
+describe('tagQueryAt', () => {
+  it('detects a tag being typed at the caret', () => {
+    expect(tagQueryAt('hello #wo', 9)).toEqual({ start: 6, end: 9, query: 'wo' })
+    expect(tagQueryAt('#', 1)).toEqual({ start: 0, end: 1, query: '' })
+    // caret in the middle of a word extends the end
+    expect(tagQueryAt('x #work y', 5)).toEqual({ start: 2, end: 7, query: 'wo' })
+  })
+  it('returns null when not in a tag', () => {
+    expect(tagQueryAt('hello wo', 8)).toBeNull()
+    expect(tagQueryAt('# heading', 9)).toBeNull()
+    expect(tagQueryAt('C#', 2)).toBeNull()
+    expect(tagQueryAt('a.com/#x', 8)).toBeNull()
+    expect(tagQueryAt('`#code', 6)).toBeNull()
+    expect(tagQueryAt('```\n#x', 6)).toBeNull()
+  })
+})
+
+describe('suggestTags', () => {
+  const tags = ['work', 'homework', 'ideas', 'workshop', 'zebra']
+  it('lists prefix matches before substring matches', () => {
+    expect(suggestTags(tags, 'work')).toEqual(['work', 'workshop', 'homework'])
+    expect(suggestTags(tags, 'WO')).toEqual(['work', 'workshop', 'homework'])
+  })
+  it('lists everything for an empty query, up to the limit', () => {
+    expect(suggestTags(tags, '')).toEqual(['homework', 'ideas', 'work', 'workshop', 'zebra'])
+    expect(suggestTags(tags, '', 2)).toHaveLength(2)
+    expect(suggestTags(tags, 'qq')).toEqual([])
+  })
+})
+
+describe('applySuggestion', () => {
+  it('completes the tag and adds a space', () => {
+    const text = 'note #wo'
+    const q = tagQueryAt(text, text.length)!
+    expect(applySuggestion(text, q, 'work')).toEqual({ text: 'note #work ', caret: 11 })
+  })
+  it('replaces the whole word and reuses following whitespace', () => {
+    const text = 'a #wxyz b'
+    const q = tagQueryAt(text, 4)!
+    expect(applySuggestion(text, q, 'work')).toEqual({ text: 'a #work b', caret: 7 })
+  })
+  it('adds a space before following punctuation', () => {
+    const text = '(#i)'
+    const q = tagQueryAt(text, 3)!
+    expect(applySuggestion(text, q, 'ideas')).toEqual({ text: '(#ideas )', caret: 8 })
+  })
+})
diff --git a/src/lib/tags.ts b/src/lib/tags.ts
new file mode 100644
index 0000000..f20fd3e
--- /dev/null
+++ b/src/lib/tags.ts
@@ -0,0 +1,166 @@
+/**
+ * Tags are `#words` written anywhere in a note's text.
+ *
+ * Rules:
+ * - A tag is `#` followed by letters, digits, `_`, and internal `-`
+ *   (`#to-do`, `#q3_goals`). Purely numeric names (`#1`) are not tags.
+ * - The `#` must not be glued to a preceding word/URL character, so `C#`,
+ *   `page#anchor`, `https://x.com/#top` and `&#39;` are not tags.
+ * - `# Heading` (hash + space) is a heading, not a tag.
+ * - Text inside inline code, fenced code blocks, link targets and bare URLs
+ *   is ignored.
+ * - Tags are case-insensitive and reported in lowercase.
+ */
+
+const NAME = String.raw`[\p{L}\p{N}_]+(?:-[\p{L}\p{N}_]+)*`
+/** Characters that may not directly precede the `#` of a tag. */
+const BEFORE = String.raw`(?<![\p{L}\p{N}_&/#\\-])`
+
+/** Matches `#name`; group 1 is the name. Global — reset lastIndex or use matchAll. */
+export const TAG_RE = new RegExp(`${BEFORE}#(${NAME})`, 'gu')
+const TAG_CHAR = /[\p{L}\p{N}_-]/u
+const VALID_NAME = new RegExp(`^${NAME}$`, 'u')
+
+export function isValidTagName(name: string): boolean {
+  return VALID_NAME.test(name) && !/^[\p{N}_-]+$/u.test(name)
+}
+
+/** Cleans user input ("#Work ") into a tag name ("work"), or null if invalid. */
+export function normalizeTag(input: string): string | null {
+  const name = input.trim().replace(/^#+/, '').toLowerCase()
+  return isValidTagName(name) ? name : null
+}
+
+const FENCE_OPEN = /^ {0,3}(`{3,}|~{3,})/
+const INLINE_CODE = /(`+)([^`]|[^`][\s\S]*?[^`])\1(?!`)/g
+const LINK_TARGET = /\]\([^)]*\)/g
+const BARE_URL = /\bhttps?:\/\/\S+/g
+
+/**
+ * Returns a copy of the Markdown with code, link targets and URLs replaced by
+ * spaces. Same length as the input, so indices map 1:1 to the source.
+ */
+export function codeMask(md: string): string {
+  const blank = (s: string) => s.replace(/[^\n]/g, ' ')
+  let fence: string | null = null
+  return md
+    .split('\n')
+    .map((line) => {
+      if (fence) {
+        if (new RegExp(`^ {0,3}${fence[0] === '`' ? '`' : '~'}{${fence.length},}\\s*$`).test(line)) fence = null
+        return blank(line)
+      }
+      const open = FENCE_OPEN.exec(line)
+      if (open) {
+        fence = open[1]
+        return blank(line)
+      }
+      return line
+        .replace(INLINE_CODE, blank)
+        .replace(LINK_TARGET, (m) => ']' + blank(m.slice(1)))
+        .replace(BARE_URL, blank)
+    })
+    .join('\n')
+}
+
+interface TagMatch {
+  /** index of the `#` */
+  index: number
+  name: string
+}
+
+function findTags(md: string): TagMatch[] {
+  const out: TagMatch[] = []
+  for (const m of codeMask(md).matchAll(TAG_RE)) {
+    if (isValidTagName(m[1])) out.push({ index: m.index, name: m[1] })
+  }
+  return out
+}
+
+/** Unique lowercase tags in order of first appearance. */
+export function extractTags(md: string): string[] {
+  return [...new Set(findTags(md).map((t) => t.name.toLowerCase()))]
+}
+
+export interface TagCount {
+  tag: string
+  count: number
+}
+
+/** Every tag with the number of notes that use it, alphabetically. */
+export function countTags(contents: string[]): TagCount[] {
+  const counts = new Map<string, number>()
+  for (const c of contents) for (const t of extractTags(c)) counts.set(t, (counts.get(t) ?? 0) + 1)
+  return [...counts]
+    .map(([tag, count]) => ({ tag, count }))
+    .sort((a, b) => a.tag.localeCompare(b.tag))
+}
+
+export function hasTag(md: string, tag: string): boolean {
+  return extractTags(md).includes(tag.toLowerCase())
+}
+
+/**
+ * Renames every occurrence of `#from` to `#to` (case-insensitive, whole tag
+ * only — `#work` does not touch `#workshop` or `#work-items`).
+ * Returns the input unchanged if `to` is invalid or nothing matched.
+ */
+export function renameTag(md: string, from: string, to: string): string {
+  const source = from.toLowerCase()
+  const target = normalizeTag(to)
+  if (!target) return md
+  let out = ''
+  let pos = 0
+  for (const t of findTags(md)) {
+    if (t.name.toLowerCase() !== source) continue
+    out += md.slice(pos, t.index) + '#' + target
+    pos = t.index + 1 + t.name.length
+  }
+  return pos === 0 ? md : out + md.slice(pos)
+}
+
+export interface TagQuery {
+  /** index of the `#` */
+  start: number
+  /** end of the tag word (may extend past the caret) */
+  end: number
+  /** what has been typed between `#` and the caret */
+  query: string
+}
+
+/**
+ * If the caret is in a `#partial` tag being typed, describes it so tags can
+ * be suggested; otherwise null (including inside code).
+ */
+export function tagQueryAt(text: string, caret: number): TagQuery | null {
+  let i = caret
+  while (i > 0 && TAG_CHAR.test(text[i - 1])) i--
+  const hash = i - 1
+  if (hash < 0 || text[hash] !== '#') return null
+  if (hash > 0 && /[\p{L}\p{N}_&/#\\-]/u.test(text[hash - 1])) return null
+  if (codeMask(text)[hash] !== '#') return null
+  // An inline code span still being typed (opening backtick, no closing one yet).
+  const lineBefore = text.slice(text.lastIndexOf('\n', hash - 1) + 1, hash)
+  if ((lineBefore.match(/`/g) ?? []).length % 2 === 1) return null
+  let end = caret
+  while (end < text.length && TAG_CHAR.test(text[end])) end++
+  return { start: hash, end, query: text.slice(hash + 1, caret) }
+}
+
+/** Tags matching the typed text: prefix matches first, then substring matches. */
+export function suggestTags(tags: string[], query: string, limit = 8): string[] {
+  const q = query.toLowerCase()
+  const prefix = tags.filter((t) => t.startsWith(q))
+  const inner = tags.filter((t) => !t.startsWith(q) && t.includes(q))
+  return [...prefix.sort(), ...inner.sort()].slice(0, limit)
+}
+
+/** Replaces the tag being typed with `#tag` and returns the new text and caret. */
+export function applySuggestion(text: string, q: TagQuery, tag: string): { text: string; caret: number } {
+  const before = text.slice(0, q.start) + '#' + tag
+  const after = text.slice(q.end)
+  if (after === '' || !/^\s/.test(after)) {
+    return { text: before + ' ' + after, caret: before.length + 1 }
+  }
+  return { text: before + after, caret: before.length }
+}
