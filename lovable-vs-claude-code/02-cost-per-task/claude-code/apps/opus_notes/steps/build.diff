+                className="icon-btn md:hidden"
+                aria-label="Back to notes"
+              >
+                <Icon name="back" />
+              </button>
+              <input
+                ref={titleRef}
+                value={active.title}
+                onChange={(e) => updateNote(active.id, { title: e.target.value })}
