+                </button>
+                <button
+                  type="button"
+                  onClick={() => updateNote(n.id, { pinned: !n.pinned }, false)}
+                  aria-label={n.pinned ? `Unpin ${displayTitle(n)}` : `Pin ${displayTitle(n)}`}
+                  aria-pressed={n.pinned}
+                  title={n.pinned ? 'Unpin' : 'Pin to top'}
