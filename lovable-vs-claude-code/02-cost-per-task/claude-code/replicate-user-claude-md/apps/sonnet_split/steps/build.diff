+import { describe, expect, it } from 'vitest'
+import { allocate, buildSummary, calculate, emptyBill, formatMoney, loadBill, parsePercent, parsePrice, saveBill, type Bill } from './split'
+
+const bill = (over: Partial<Bill> = {}): Bill => ({
+  ...emptyBill(),
+  people: [{ id: 'a', name: 'Ann' }, { id: 'b', name: 'Bob' }, { id: 'c', name: 'Cy' }],
+  ...over,
+})
+
+describe('allocate', () => {
+  it('sums exactly', () => {
+    expect(allocate(100, [1, 1, 1])).toEqual([34, 33, 33])
+    expect(allocate(0, [1, 2])).toEqual([0, 0])
+    expect(allocate(5, [0, 0])).toEqual([3, 2])
+  })
+  it('sums exactly for random inputs', () => {
+    for (let n = 0; n < 500; n++) {
+      const total = Math.floor(Math.random() * 100000)
+      const w = Array.from({ length: 1 + Math.floor(Math.random() * 8) }, () => Math.floor(Math.random() * 5000))
+      const out = allocate(total, w)
+      expect(out.reduce((a, b) => a + b, 0)).toBe(total)
+      expect(out.every((x) => x >= 0)).toBe(true)
+    }
+  })
+})
+
+describe('parsePrice', () => {
+  it('parses', () => {
+    expect(parsePrice('12.50').cents).toBe(1250)
+    expect(parsePrice('12,5').cents).toBe(1250)
+    expect(parsePrice('7').cents).toBe(700)
+    expect(parsePrice('.99').cents).toBe(99)
+    expect(parsePrice('0.07').cents).toBe(7)
+  })
+  it('rejects', () => {
+    expect(parsePrice('-3').error).toMatch(/negative/)
+    expect(parsePrice('').error).toBeTruthy()
+    expect(parsePrice('abc').error).toBeTruthy()
+    expect(parsePrice('1.234').error).toMatch(/2 decimal/)
+    expect(parsePrice('0').error).toBeTruthy()
+  })
+})
+
+describe('parsePercent', () => {
+  it('handles empty, valid, invalid', () => {
+    expect(parsePercent('', 'Tax').pct).toBe(0)
+    expect(parsePercent('8.25', 'Tax').pct).toBe(8.25)
+    expect(parsePercent('-1', 'Tax').error).toMatch(/negative/)
+    expect(parsePercent('x', 'Tip').error).toBeTruthy()
+    expect(parsePercent('101', 'Tip').error).toBeTruthy()
+  })
+})
+
+describe('calculate', () => {
+  it('splits shared items, tax and tip proportionally', () => {
+    const r = calculate(bill({
+      items: [
+        { id: '1', name: 'Pizza', cents: 3000, people: ['a', 'b'] },
+        { id: '2', name: 'Wine', cents: 2000, people: ['c'] },
+      ],
+      taxInput: '10', tipInput: '20',
+    }))
+    expect(r.subtotal).toBe(5000)
+    expect(r.tax).toBe(500)
+    expect(r.tip).toBe(1000)
+    expect(r.people.map((p) => p.subtotal)).toEqual([1500, 1500, 2000])
+    expect(r.people.map((p) => p.tax)).toEqual([150, 150, 200])
+    expect(r.people.map((p) => p.tip)).toEqual([300, 300, 400])
+    expect(r.total).toBe(6500)
+  })
+  it('per-person totals always add up to the bill total', () => {
+    for (let n = 0; n < 300; n++) {
+      const people = Array.from({ length: 1 + Math.floor(Math.random() * 7) }, (_, i) => ({ id: 'p' + i, name: 'P' + i }))
+      const items = Array.from({ length: Math.floor(Math.random() * 10) }, (_, i) => ({
+        id: 'i' + i, name: 'x', cents: 1 + Math.floor(Math.random() * 9999),
+        people: people.filter(() => Math.random() < 0.5).map((p) => p.id),
+      }))
+      const b = { ...emptyBill(), people, items, taxInput: String(Math.random() * 25), tipInput: String(Math.random() * 30) }
+      const r = calculate(b)
+      expect(r.people.reduce((s, p) => s + p.total, 0)).toBe(r.total)
+      expect(r.people.reduce((s, p) => s + p.tax, 0)).toBe(r.tax)
+      expect(r.people.reduce((s, p) => s + p.tip, 0)).toBe(r.tip)
+      expect(r.people.reduce((s, p) => s + p.subtotal, 0)).toBe(r.subtotal)
+      expect(r.total).toBe(r.subtotal + r.tax + r.tip)
+    }
+  })
+  it('handles one-cent thirds', () => {
+    const r = calculate(bill({ items: [{ id: '1', name: 'x', cents: 100, people: ['a', 'b', 'c'] }] }))
+    expect(r.people.map((p) => p.total)).toEqual([34, 33, 33])
+  })
+  it('reports items nobody shares and excludes them', () => {
+    const r = calculate(bill({ items: [{ id: '1', name: 'x', cents: 100, people: ['gone'] }] }))
+    expect(r.unassigned).toHaveLength(1)
+    expect(r.total).toBe(0)
+  })
+  it('works with no people / no items', () => {
+    expect(calculate(emptyBill()).total).toBe(0)
+    expect(calculate(bill()).people.every((p) => p.total === 0)).toBe(true)
+  })
+})
+
+describe('formatting and summary', () => {
+  it('formats per currency', () => {
+    expect(formatMoney(123456, 'USD')).toBe('$1,234.56')
+    expect(formatMoney(1250, 'EUR')).toMatch(/^12,50\s€$/)
+    expect(formatMoney(1250, 'PLN')).toMatch(/^12,50\szł$/)
+  })
+  it('builds a plain-text summary', () => {
+    const b = bill({ items: [{ id: '1', name: 'Pizza', cents: 3000, people: ['a', 'b'] }], taxInput: '10' })
+    const s = buildSummary(b, calculate(b))
+    expect(s).toContain('Pizza: $30.00 (Ann, Bob)')
+    expect(s).toContain('Total: $33.00')
+    expect(s).toContain('- Ann: $16.50')
+  })
+})
+
+describe('persistence', () => {
+  it('round-trips', () => {
+    const store: Record<string, string> = {}
+    const st = { getItem: (k: string) => store[k] ?? null, setItem: (k: string, v: string) => void (store[k] = v) }
+    const b = bill({ currency: 'PLN', taxInput: '8', items: [{ id: '1', name: 'x', cents: 5, people: ['a'] }] })
+    saveBill(b, st)
+    expect(loadBill(st)).toEqual(b)
+  })
+  it('survives corrupt data', () => {
+    expect(loadBill({ getItem: () => '{nope' })).toEqual(emptyBill())
+    const l = loadBill({ getItem: () => JSON.stringify({ people: 5, items: [{ id: 1 }], currency: 'XXX' }) })
+    expect(l).toEqual(emptyBill())
+  })
+})
diff --git a/src/lib/split.ts b/src/lib/split.ts
new file mode 100644
index 0000000..57db455
--- /dev/null
+++ b/src/lib/split.ts
@@ -0,0 +1,170 @@
+export type Currency = 'USD' | 'EUR' | 'PLN'
+export const CURRENCIES: Currency[] = ['USD', 'EUR', 'PLN']
+
+export interface Person { id: string; name: string }
+export interface Item { id: string; name: string; cents: number; people: string[] }
+
+export interface Bill {
+  people: Person[]
+  items: Item[]
+  taxInput: string
+  tipInput: string
+  currency: Currency
+}
+
+export const emptyBill = (): Bill => ({ people: [], items: [], taxInput: '', tipInput: '', currency: 'USD' })
+
+/** Split `total` cents over `weights` so the parts sum exactly to `total` (largest remainder). */
+export function allocate(total: number, weights: number[]): number[] {
+  const sum = weights.reduce((a, b) => a + b, 0)
+  if (weights.length === 0) return []
+  if (sum === 0) {
+    // no basis: split evenly
+    return allocate(total, weights.map(() => 1))
+  }
+  const base = weights.map((w) => Math.floor((total * w) / sum))
+  const rem = weights.map((w, i) => ({ i, r: (total * w) % sum }))
+  let left = total - base.reduce((a, b) => a + b, 0)
+  rem.sort((a, b) => b.r - a.r || a.i - b.i)
+  for (const { i } of rem) {
+    if (left <= 0) break
+    base[i]++
+    left--
+  }
+  return base
+}
+
+const NUM = /^(\d+\.?\d*|\.\d+)$/
+
+/** Parse a money string ("12.50" or "12,5") to cents. */
+export function parsePrice(raw: string): { cents?: number; error?: string } {
+  const s = raw.trim().replace(',', '.')
+  if (s === '') return { error: 'Enter a price.' }
+  if (s.startsWith('-')) return { error: 'Price cannot be negative.' }
+  if (!NUM.test(s)) return { error: 'Price must be a number, e.g. 12.50.' }
+  if (/\.\d{3,}/.test(s)) return { error: 'Price can have at most 2 decimal places.' }
+  const [w, f = ''] = s.split('.')
+  const cents = Number(w || '0') * 100 + Number(f.padEnd(2, '0'))
+  if (!Number.isSafeInteger(cents) || cents > 10_000_000_000) return { error: 'Price is too large.' }
+  if (cents === 0) return { error: 'Price must be greater than zero.' }
+  return { cents }
+}
+
+/** Parse a percentage field. Empty means 0. */
+export function parsePercent(raw: string, label: string): { pct: number; error?: string } {
+  const s = raw.trim().replace(',', '.')
+  if (s === '') return { pct: 0 }
+  if (s.startsWith('-')) return { pct: 0, error: `${label} cannot be negative.` }
+  if (!NUM.test(s)) return { pct: 0, error: `${label} must be a number, e.g. 8.5.` }
+  const pct = Number(s)
+  if (pct > 100) return { pct: 0, error: `${label} cannot be more than 100%.` }
+  return { pct }
+}
+
+export interface PersonResult {
+  id: string
+  name: string
+  subtotal: number
+  tax: number
+  tip: number
+  total: number
+}
+
+export interface Result {
+  people: PersonResult[]
+  subtotal: number
+  tax: number
+  tip: number
+  total: number
+  unassigned: Item[]
+  taxError?: string
+  tipError?: string
+}
+
+export const displayName = (p: Person, idx: number) => p.name.trim() || `Person ${idx + 1}`
+
+export function calculate(bill: Bill): Result {
+  const { people, items } = bill
+  const ids = new Set(people.map((p) => p.id))
+  const subs = new Map(people.map((p) => [p.id, 0]))
+  const unassigned: Item[] = []
+  for (const item of items) {
+    const sharers = item.people.filter((id) => ids.has(id))
+    if (sharers.length === 0) { unassigned.push(item); continue }
+    allocate(item.cents, sharers.map(() => 1)).forEach((c, i) => subs.set(sharers[i], subs.get(sharers[i])! + c))
+  }
+  const subtotals = people.map((p) => subs.get(p.id)!)
+  const subtotal = subtotals.reduce((a, b) => a + b, 0)
+  const taxP = parsePercent(bill.taxInput, 'Tax')
+  const tipP = parsePercent(bill.tipInput, 'Tip')
+  const tax = Math.round((subtotal * taxP.pct) / 100)
+  const tip = Math.round((subtotal * tipP.pct) / 100)
+  const taxes = subtotal ? allocate(tax, subtotals) : subtotals.map(() => 0)
+  const tips = subtotal ? allocate(tip, subtotals) : subtotals.map(() => 0)
+  const rows = people.map((p, i) => ({
+    id: p.id,
+    name: displayName(p, i),
+    subtotal: subtotals[i],
+    tax: taxes[i],
+    tip: tips[i],
+    total: subtotals[i] + taxes[i] + tips[i],
+  }))
+  return { people: rows, subtotal, tax, tip, total: subtotal + tax + tip, unassigned, taxError: taxP.error, tipError: tipP.error }
+}
+
+const LOCALES: Record<Currency, string> = { USD: 'en-US', EUR: 'de-DE', PLN: 'pl-PL' }
+
+export function formatMoney(cents: number, currency: Currency): string {
+  return new Intl.NumberFormat(LOCALES[currency], { style: 'currency', currency }).format(cents / 100)
+}
+
+export function buildSummary(bill: Bill, r: Result): string {
+  const m = (c: number) => formatMoney(c, bill.currency)
+  const lines = ['Bill summary', '']
+  lines.push('Items:')
+  for (const it of bill.items) {
+    const names = it.people.map((id) => r.people.find((p) => p.id === id)?.name).filter(Boolean).join(', ')
+    lines.push(`- ${it.name}: ${m(it.cents)} (${names || 'nobody'})`)
+  }
+  if (!bill.items.length) lines.push('- (none)')
+  lines.push('', `Subtotal: ${m(r.subtotal)}`)
+  lines.push(`Tax (${bill.taxInput.trim() || 0}%): ${m(r.tax)}`)
+  lines.push(`Tip (${bill.tipInput.trim() || 0}%): ${m(r.tip)}`)
+  lines.push(`Total: ${m(r.total)}`, '', 'Per person:')
+  for (const p of r.people) {
+    lines.push(`- ${p.name}: ${m(p.total)} (items ${m(p.subtotal)}, tax ${m(p.tax)}, tip ${m(p.tip)})`)
+  }
+  if (!r.people.length) lines.push('- (nobody)')
+  return lines.join('\n')
+}
+
+const KEY = 'bill-splitter:v1'
+
+export function loadBill(storage: Pick<Storage, 'getItem'> = localStorage): Bill {
+  try {
+    const raw = storage.getItem(KEY)
+    if (!raw) return emptyBill()
+    const d = JSON.parse(raw)
+    const people: Person[] = Array.isArray(d.people)
+      ? d.people.filter((p: Person) => p && typeof p.id === 'string' && typeof p.name === 'string').map((p: Person) => ({ id: p.id, name: p.name }))
+      : []
+    const items: Item[] = Array.isArray(d.items)
+      ? d.items
+          .filter((i: Item) => i && typeof i.id === 'string' && typeof i.name === 'string' && Number.isSafeInteger(i.cents) && i.cents > 0 && Array.isArray(i.people))
+          .map((i: Item) => ({ id: i.id, name: i.name, cents: i.cents, people: i.people.filter((x) => typeof x === 'string') }))
+      : []
+    return {
+      people,
+      items,
+      taxInput: typeof d.taxInput === 'string' ? d.taxInput : '',
+      tipInput: typeof d.tipInput === 'string' ? d.tipInput : '',
+      currency: CURRENCIES.includes(d.currency) ? d.currency : 'USD',
+    }
+  } catch {
+    return emptyBill()
+  }
+}
+
+export function saveBill(bill: Bill, storage: Pick<Storage, 'setItem'> = localStorage) {
+  try { storage.setItem(KEY, JSON.stringify(bill)) } catch { /* storage full or blocked */ }
+}
