+    expect(validateItem({ name: 'Soup', price: '5', sharedBy: ['ghost'] }, people).errors.sharedBy).toBeDefined()
+    expect(validateItem({ name: 'Soup', price: '5', sharedBy: [] }, []).errors.sharedBy).toBe('Add at least one person first.')
