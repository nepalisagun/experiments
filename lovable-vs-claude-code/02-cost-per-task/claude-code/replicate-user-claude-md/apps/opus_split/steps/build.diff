+import { formatMoney, formatPercent, type Breakdown as B, type Currency } from '../lib/bill'
+
+export function Breakdown({ breakdown: b, currency }: { breakdown: B; currency: Currency }) {
+  const m = (c: number) => formatMoney(c, currency)
+
+  return (
+    <section className="card" aria-labelledby="breakdown-title">
+      <h2 id="breakdown-title" className="card-title">
+        Per person
+      </h2>
+
+      {b.shares.length === 0 ? (
+        <p className="text-sm text-stone-500">Add people and items to see who owes what.</p>
+      ) : (
+        <ul className="space-y-3" aria-label="Per-person breakdown">
+          {b.shares.map((s) => (
+            <li key={s.personId} className="rounded-lg border border-stone-200 p-3" data-testid="share">
+              <div className="flex items-baseline justify-between gap-2">
+                <span className="truncate font-semibold" data-testid="share-name">
+                  {s.name}
+                </span>
+                <span className="shrink-0 text-lg font-semibold tabular-nums" data-testid="share-total">
+                  {m(s.total)}
+                </span>
+              </div>
+              <dl className="mt-1 grid grid-cols-3 gap-2 text-sm text-stone-600">
+                <div>
+                  <dt className="text-xs text-stone-500">Items</dt>
+                  <dd className="tabular-nums" data-testid="share-subtotal">{m(s.subtotal)}</dd>
+                </div>
+                <div>
+                  <dt className="text-xs text-stone-500">Tax</dt>
+                  <dd className="tabular-nums" data-testid="share-tax">{m(s.tax)}</dd>
+                </div>
+                <div>
+                  <dt className="text-xs text-stone-500">Tip</dt>
+                  <dd className="tabular-nums" data-testid="share-tip">{m(s.tip)}</dd>
+                </div>
+              </dl>
+              {s.items.length > 0 && (
+                <p className="mt-1 truncate text-xs text-stone-500" title={s.items.map((i) => i.name).join(', ')}>
+                  {s.items.map((i) => (i.sharedWith > 1 ? `${i.name} (1/${i.sharedWith})` : i.name)).join(', ')}
+                </p>
+              )}
+            </li>
+          ))}
+        </ul>
+      )}
+
+      <dl className="mt-4 space-y-1 border-t border-stone-200 pt-3 text-sm" aria-label="Bill totals">
+        <Row label="Subtotal" value={m(b.subtotal)} testId="bill-subtotal" />
+        <Row label={`Tax (${formatPercent(b.taxPctScaled)})`} value={m(b.tax)} testId="bill-tax" />
+        <Row label={`Tip (${formatPercent(b.tipPctScaled)})`} value={m(b.tip)} testId="bill-tip" />
+        <div className="flex justify-between pt-1 text-base font-semibold">
+          <dt>Total</dt>
+          <dd className="tabular-nums" data-testid="bill-total">
+            {m(b.total)}
+          </dd>
+        </div>
+      </dl>
+    </section>
+  )
+}
+
+function Row({ label, value, testId }: { label: string; value: string; testId: string }) {
+  return (
+    <div className="flex justify-between text-stone-600">
+      <dt>{label}</dt>
+      <dd className="tabular-nums" data-testid={testId}>
+        {value}
+      </dd>
+    </div>
+  )
+}
diff --git a/src/components/ConfirmDialog.tsx b/src/components/ConfirmDialog.tsx
new file mode 100644
index 0000000..1373b20
--- /dev/null
+++ b/src/components/ConfirmDialog.tsx
@@ -0,0 +1,52 @@
+import { useEffect, useId, useRef } from 'react'
+
+interface Props {
+  open: boolean
+  title: string
+  message: React.ReactNode
+  confirmLabel: string
+  onConfirm: () => void
+  onCancel: () => void
+}
+
+export function ConfirmDialog({ open, title, message, confirmLabel, onConfirm, onCancel }: Props) {
+  const ref = useRef<HTMLDialogElement>(null)
+  const titleId = useId()
+
+  useEffect(() => {
+    const d = ref.current
+    if (!d) return
+    if (open && !d.open) d.showModal()
+    if (!open && d.open) d.close()
+  }, [open])
+
+  return (
+    <dialog
+      ref={ref}
+      onCancel={(e) => {
+        e.preventDefault()
+        onCancel()
+      }}
+      onClick={(e) => {
+        if (e.target === ref.current) onCancel()
+      }}
+      aria-labelledby={titleId}
+      className="m-auto w-[calc(100%-2rem)] max-w-sm rounded-xl bg-white p-0 text-stone-900 shadow-xl backdrop:bg-stone-900/40"
+    >
+      <div className="p-5">
+        <h2 id={titleId} className="text-lg font-semibold">
+          {title}
+        </h2>
+        <div className="mt-2 text-sm text-stone-600">{message}</div>
+        <div className="mt-5 flex justify-end gap-2">
+          <button type="button" className="btn-secondary" onClick={onCancel} autoFocus>
+            Cancel
+          </button>
+          <button type="button" className="btn-danger" onClick={onConfirm}>
+            {confirmLabel}
+          </button>
+        </div>
+      </div>
+    </dialog>
+  )
+}
diff --git a/src/components/Items.tsx b/src/components/Items.tsx
new file mode 100644
index 0000000..c464760
--- /dev/null
+++ b/src/components/Items.tsx
@@ -0,0 +1,224 @@
+import { useState } from 'react'
+import { formatMoney, validateItem, type Currency, type Item, type ItemDraft, type ItemErrors, type Person } from '../lib/bill'
+
+interface Props {
+  items: Item[]
+  people: Person[]
+  currency: Currency
+  onAdd: (item: Omit<Item, 'id'>) => void
+  onUpdate: (id: string, item: Omit<Item, 'id'>) => void
+  onRemove: (id: string) => void
+}
+
+export function Items({ items, people, currency, onAdd, onUpdate, onRemove }: Props) {
+  const [editingId, setEditingId] = useState<string | null>(null)
+  const nameOf = (id: string) => people.find((p) => p.id === id)?.name ?? '?'
+
+  return (
+    <section className="card" aria-labelledby="items-title">
+      <h2 id="items-title" className="card-title">
+        Items <span className="font-normal text-stone-500">({items.length})</span>
+      </h2>
+
+      <ItemForm
+        idPrefix="new-item"
+        people={people}
+        submitLabel="Add item"
+        onSubmit={(it) => {
+          onAdd(it)
+          return true
+        }}
+      />
+
+      {items.length === 0 ? (
+        <p className="mt-4 text-sm text-stone-500">No items yet.</p>
+      ) : (
+        <ul className="mt-4 divide-y divide-stone-100 border-t border-stone-100" aria-label="Item list">
+          {items.map((it) =>
+            editingId === it.id ? (
+              <li key={it.id} className="py-3">
+                <ItemForm
+                  idPrefix={`edit-${it.id}`}
+                  people={people}
+                  initial={{ name: it.name, price: (it.priceCents / 100).toFixed(2), sharedBy: it.sharedBy }}
+                  submitLabel="Save"
+                  onCancel={() => setEditingId(null)}
+                  onSubmit={(upd) => {
+                    onUpdate(it.id, upd)
+                    setEditingId(null)
+                    return true
+                  }}
+                />
+              </li>
+            ) : (
+              <li key={it.id} className="flex items-start gap-2 py-3" data-testid="item-row">
+                <div className="min-w-0 flex-1">
+                  <div className="flex items-baseline justify-between gap-2">
+                    <span className="truncate font-medium">{it.name}</span>
+                    <span className="shrink-0 tabular-nums">{formatMoney(it.priceCents, currency)}</span>
+                  </div>
+                  <p className="mt-0.5 text-sm text-stone-500">
+                    {it.sharedBy.length === 1 ? 'For ' : `Shared by ${it.sharedBy.length}: `}
+                    {it.sharedBy.map(nameOf).join(', ')}
+                  </p>
+                </div>
+                <div className="flex shrink-0 flex-col gap-1 sm:flex-row">
+                  <button type="button" className="btn-ghost" aria-label={`Edit ${it.name}`} onClick={() => setEditingId(it.id)}>
+                    Edit
+                  </button>
+                  <button
+                    type="button"
+                    className="btn-ghost text-red-600 hover:bg-red-50 hover:text-red-700"
+                    aria-label={`Remove ${it.name}`}
+                    onClick={() => {
+                      if (editingId === it.id) setEditingId(null)
+                      onRemove(it.id)
+                    }}
+                  >
+                    Remove
+                  </button>
+                </div>
+              </li>
+            ),
+          )}
+        </ul>
+      )}
+    </section>
+  )
+}
+
+function ItemForm({
+  idPrefix,
+  people,
+  initial,
+  submitLabel,
+  onSubmit,
+  onCancel,
+}: {
+  idPrefix: string
+  people: Person[]
+  initial?: ItemDraft
+  submitLabel: string
+  onSubmit: (item: Omit<Item, 'id'>) => boolean
+  onCancel?: () => void
+}) {
+  const [draft, setDraft] = useState<ItemDraft>(initial ?? { name: '', price: '', sharedBy: [] })
+  const [errors, setErrors] = useState<ItemErrors>({})
+  const set = (patch: Partial<ItemDraft>, clear: keyof ItemErrors) => {
+    setDraft((d) => ({ ...d, ...patch }))
+    if (errors[clear]) setErrors((e) => ({ ...e, [clear]: undefined }))
+  }
+  const toggle = (id: string) =>
+    set({ sharedBy: draft.sharedBy.includes(id) ? draft.sharedBy.filter((x) => x !== id) : [...draft.sharedBy, id] }, 'sharedBy')
+  const allSelected = people.length > 0 && people.every((p) => draft.sharedBy.includes(p.id))
+
+  const submit = (e: React.FormEvent) => {
+    e.preventDefault()
+    const { errors: errs, priceCents } = validateItem(draft, people)
+    setErrors(errs)
+    if (Object.keys(errs).length > 0 || priceCents === undefined) {
+      const first = (['name', 'price'] as const).find((k) => errs[k])
+      if (first) document.getElementById(`${idPrefix}-${first}`)?.focus()
+      return
+    }
+    // keep sharers in people order
+    const sharedBy = people.filter((p) => draft.sharedBy.includes(p.id)).map((p) => p.id)
+    if (onSubmit({ name: draft.name.trim(), priceCents, sharedBy }) && !initial) {
+      setDraft({ name: '', price: '', sharedBy: [] })
+      document.getElementById(`${idPrefix}-name`)?.focus()
+    }
+  }
+
+  const err = (k: keyof ItemErrors) =>
+    errors[k] ? (
+      <p id={`${idPrefix}-${k}-error`} role="alert" className="error-text">
+        {errors[k]}
+      </p>
+    ) : null
+
+  return (
+    <form onSubmit={submit} noValidate aria-label={initial ? 'Edit item' : 'Add item'} className="space-y-3">
+      <div className="grid grid-cols-[1fr_7.5rem] gap-2">
+        <div className="min-w-0">
+          <label htmlFor={`${idPrefix}-name`} className="mb-1 block text-sm font-medium text-stone-700">
+            Item
+          </label>
+          <input
+            id={`${idPrefix}-name`}
+            className="input"
+            placeholder="e.g. Margherita pizza"
+            value={draft.name}
+            maxLength={80}
+            aria-invalid={!!errors.name}
+            aria-describedby={errors.name ? `${idPrefix}-name-error` : undefined}
+            onChange={(e) => set({ name: e.target.value }, 'name')}
+          />
+        </div>
+        <div className="min-w-0">
+          <label htmlFor={`${idPrefix}-price`} className="mb-1 block text-sm font-medium text-stone-700">
+            Price
+          </label>
+          <input
+            id={`${idPrefix}-price`}
+            className="input tabular-nums"
+            placeholder="0.00"
+            inputMode="decimal"
+            value={draft.price}
+            aria-invalid={!!errors.price}
+            aria-describedby={errors.price ? `${idPrefix}-price-error` : undefined}
+            onChange={(e) => set({ price: e.target.value }, 'price')}
+          />
+        </div>
+      </div>
+      {err('name')}
+      {err('price')}
+
+      <fieldset aria-describedby={errors.sharedBy ? `${idPrefix}-sharedBy-error` : undefined}>
+        <div className="mb-1 flex items-center justify-between">
+          <legend className="text-sm font-medium text-stone-700">Shared by</legend>
+          {people.length > 1 && (
+            <button
+              type="button"
+              className="text-sm font-medium text-emerald-700 hover:underline"
+              onClick={() => set({ sharedBy: allSelected ? [] : people.map((p) => p.id) }, 'sharedBy')}
+            >
+              {allSelected ? 'Clear' : 'Everyone'}
+            </button>
+          )}
+        </div>
+        {people.length === 0 ? (
+          <p className="text-sm text-stone-500">Add people above first.</p>
+        ) : (
+          <div className="flex flex-wrap gap-2">
+            {people.map((p) => {
+              const on = draft.sharedBy.includes(p.id)
+              return (
+                <label
+                  key={p.id}
+                  className={`flex cursor-pointer items-center gap-1.5 rounded-full border px-3 py-1.5 text-sm select-none has-focus-visible:ring-2 has-focus-visible:ring-emerald-600/40 ${
+                    on ? 'border-emerald-700 bg-emerald-50 text-emerald-900' : 'border-stone-300 bg-white text-stone-700'
+                  } ${errors.sharedBy ? 'border-red-400' : ''}`}
+                >
+                  <input type="checkbox" className="accent-emerald-700" checked={on} onChange={() => toggle(p.id)} />
+                  <span className="max-w-[10rem] truncate">{p.name}</span>
+                </label>
+              )
+            })}
+          </div>
+        )}
+        {err('sharedBy')}
+      </fieldset>
+
+      <div className="flex gap-2">
+        <button type="submit" className="btn-primary">
+          {submitLabel}
+        </button>
+        {onCancel && (
+          <button type="button" className="btn-secondary" onClick={onCancel}>
+            Cancel
+          </button>
+        )}
+      </div>
+    </form>
+  )
+}
diff --git a/src/components/People.tsx b/src/components/People.tsx
new file mode 100644
index 0000000..9318478
--- /dev/null
+++ b/src/components/People.tsx
@@ -0,0 +1,168 @@
+import { useState } from 'react'
+import { validatePersonName, type Person } from '../lib/bill'
+
+interface Props {
+  people: Person[]
+  onAdd: (name: string) => void
+  onRename: (id: string, name: string) => void
+  onRemove: (id: string) => void
+}
+
+export function People({ people, onAdd, onRename, onRemove }: Props) {
+  const [name, setName] = useState('')
+  const [error, setError] = useState<string | null>(null)
+
+  const add = (e: React.FormEvent) => {
+    e.preventDefault()
+    const err = validatePersonName(name, people)
+    setError(err)
+    if (err) return
+    onAdd(name.trim())
+    setName('')
+  }
+
+  return (
+    <section className="card" aria-labelledby="people-title">
+      <h2 id="people-title" className="card-title">
+        People <span className="font-normal text-stone-500">({people.length})</span>
+      </h2>
+      <form onSubmit={add} noValidate>
+        <div className="flex gap-2">
+          <label htmlFor="new-person" className="sr-only">
+            New person's name
+          </label>
+          <input
+            id="new-person"
+            className="input"
+            placeholder="Add a person, e.g. Alex"
+            value={name}
+            maxLength={60}
+            aria-invalid={!!error}
+            aria-describedby={error ? 'new-person-error' : undefined}
+            onChange={(e) => {
+              setName(e.target.value)
+              if (error) setError(null)
+            }}
+          />
+          <button type="submit" className="btn-primary">
+            Add
+          </button>
+        </div>
+        {error && (
+          <p id="new-person-error" role="alert" className="error-text">
+            {error}
+          </p>
+        )}
+      </form>
+
+      {people.length === 0 ? (
+        <p className="mt-3 text-sm text-stone-500">No one yet. Add everyone who was at the dinner.</p>
+      ) : (
+        <ul className="mt-3 divide-y divide-stone-100">
+          {people.map((p) => (
+            <PersonRow key={p.id} person={p} people={people} onRename={onRename} onRemove={onRemove} />
+          ))}
+        </ul>
+      )}
+    </section>
+  )
+}
+
+function PersonRow({
+  person,
+  people,
+  onRename,
+  onRemove,
+}: {
+  person: Person
+  people: Person[]
+  onRename: Props['onRename']
+  onRemove: Props['onRemove']
+}) {
+  const [editing, setEditing] = useState(false)
+  const [draft, setDraft] = useState(person.name)
+  const [error, setError] = useState<string | null>(null)
+  const errId = `rename-error-${person.id}`
+
+  const save = (e: React.FormEvent) => {
+    e.preventDefault()
+    const err = validatePersonName(draft, people, person.id)
+    setError(err)
+    if (err) return
+    onRename(person.id, draft.trim())
+    setEditing(false)
+  }
+
+  if (editing) {
+    return (
+      <li className="py-2">
+        <form onSubmit={save} noValidate className="flex flex-wrap gap-2">
+          <input
+            className="input flex-1 basis-40"
+            aria-label={`New name for ${person.name}`}
+            value={draft}
+            maxLength={60}
+            autoFocus
+            aria-invalid={!!error}
+            aria-describedby={error ? errId : undefined}
+            onChange={(e) => {
+              setDraft(e.target.value)
+              if (error) setError(null)
+            }}
+            onKeyDown={(e) => {
+              if (e.key === 'Escape') {
+                setEditing(false)
+                setError(null)
+              }
+            }}
+          />
+          <div className="flex gap-2">
+            <button type="submit" className="btn-primary">
+              Save
+            </button>
+            <button
+              type="button"
+              className="btn-secondary"
+              onClick={() => {
+                setEditing(false)
+                setError(null)
+              }}
+            >
+              Cancel
+            </button>
+          </div>
+        </form>
+        {error && (
+          <p id={errId} role="alert" className="error-text">
+            {error}
+          </p>
+        )}
+      </li>
+    )
+  }
+
+  return (
+    <li className="flex items-center gap-2 py-2">
+      <span className="flex-1 truncate font-medium">{person.name}</span>
+      <button
+        type="button"
+        className="btn-ghost"
+        aria-label={`Rename ${person.name}`}
+        onClick={() => {
+          setDraft(person.name)
+          setEditing(true)
+        }}
+      >
+        Rename
+      </button>
+      <button
+        type="button"
+        className="btn-ghost text-red-600 hover:bg-red-50 hover:text-red-700"
+        aria-label={`Remove ${person.name}`}
+        onClick={() => onRemove(person.id)}
+      >
+        Remove
+      </button>
+    </li>
+  )
+}
diff --git a/src/components/TaxTip.tsx b/src/components/TaxTip.tsx
new file mode 100644
