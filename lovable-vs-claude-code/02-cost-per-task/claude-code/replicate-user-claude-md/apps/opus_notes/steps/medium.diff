+import { describe, expect, it } from 'vitest'
+import { renderMarkdown } from './markdown'
+import { applyTag, extractTags, normalizeTag, renameTag, suggestTags, tagCounts, tagQueryAt } from './tags'
+
+describe('extractTags', () => {
+  it('finds tags anywhere in the text, lower-cased and de-duplicated', () => {
+    expect(extractTags('#Work stuff #todo\n- [ ] call #work, then (#home)')).toEqual(['work', 'todo', 'home'])
+  })
+  it('accepts -, _, / and digits inside a tag and drops trailing punctuation', () => {
+    expect(extractTags('#work-items #a_b #project/alpha #v2. #todo- #x/')).toEqual([
+      'work-items',
+      'a_b',
+      'project/alpha',
+      'v2',
+      'todo',
+      'x',
+    ])
+  })
+  it('handles non-English letters', () => {
+    expect(extractTags('#zażółć #日本')).toEqual(['zażółć', '日本'])
+  })
+  it('ignores headings, numbers, mid-word #, URL fragments and anchor links', () => {
+    expect(
+      extractTags('# Heading\n## Sub\nissue #12\nC#sharp a#b\nhttps://x.com/#frag\n[x](#anchor)\n&#39;'),
+    ).toEqual([])
+  })
+  it('ignores tags in fenced code and inline code', () => {
+    expect(extractTags('```\n#include\n```\n~~~\n#x\n~~~\n`#nope` but #yes')).toEqual(['yes'])
+  })
+  it('finds tags inside emphasis, quotes and lists', () => {
+    expect(extractTags('**#bold** "#quoted" > #q\n1. #num')).toEqual(['bold', 'quoted', 'q', 'num'])
+  })
+})
+
+describe('tagCounts', () => {
+  it('counts notes per tag (not occurrences), alphabetical', () => {
+    expect(tagCounts(['#b #a #a', '#A', 'none', '#c #b'])).toEqual([
+      { tag: 'a', count: 2 },
+      { tag: 'b', count: 2 },
+      { tag: 'c', count: 1 },
+    ])
+  })
+})
+
+describe('normalizeTag', () => {
+  it('accepts a name with or without #', () => {
+    expect(normalizeTag('#ideas')).toBe('ideas')
+    expect(normalizeTag(' work-2 ')).toBe('work-2')
+    expect(normalizeTag('a/b')).toBe('a/b')
+  })
+  it('rejects things that would not be a tag', () => {
+    for (const bad of ['', '#', '12', 'two words', 'bad!', '-x', 'x-', '##x']) expect(normalizeTag(bad)).toBeNull()
+  })
+})
+
+describe('renameTag', () => {
+  it('renames every case variant as a whole tag only', () => {
+    expect(renameTag('#work and #Work, #working, #work-items, #work/x', 'work', 'job')).toBe(
+      '#job and #job, #working, #work-items, #work/x',
+    )
+  })
+  it('leaves code blocks, inline code and non-tags alone', () => {
+    const src = '# work\n`#work`\n```\n#work\n```\nemail#work #work'
+    expect(renameTag(src, 'work', 'job')).toBe('# work\n`#work`\n```\n#work\n```\nemail#work #job')
+  })
+  it('keeps CRLF and other text unchanged', () => {
+    expect(renameTag('a #x\r\nb #x.', 'x', 'y')).toBe('a #y\r\nb #y.')
+  })
+  it('the renamed tag is what extractTags then reports', () => {
+    expect(extractTags(renameTag('#Old #other', 'old', 'new-name'))).toEqual(['new-name', 'other'])
+  })
+})
+
+describe('tagQueryAt (autocomplete trigger)', () => {
+  const at = (s: string) => tagQueryAt(s.replace('|', ''), s.indexOf('|'))
+  it('detects a # being typed', () => {
+    expect(at('hello #|')).toEqual({ start: 6, prefix: '' })
+    expect(at('hello #wo|')).toEqual({ start: 6, prefix: 'wo' })
+    expect(at('#wo|')).toEqual({ start: 0, prefix: 'wo' })
+    expect(at('line\n(#a/b|')).toEqual({ start: 6, prefix: 'a/b' })
+  })
+  it('does not trigger after a space, mid-word, or in code', () => {
+    expect(at('# |')).toBeNull()
+    expect(at('#wo |')).toBeNull()
+    expect(at('a#wo|')).toBeNull()
+    expect(at('`#wo|')).toBeNull()
+    expect(at('```\n#inc|')).toBeNull()
+    expect(at('```\nx\n```\n#ok|')).toEqual({ start: 10, prefix: 'ok' })
+  })
+})
+
+describe('suggestTags', () => {
+  const tags = ['work', 'workout', 'homework', 'ideas', 'w']
+  it('prefix matches first, then substring matches, excluding the exact tag typed', () => {
+    expect(suggestTags(tags, 'work')).toEqual(['workout', 'homework'])
+    expect(suggestTags(tags, 'WO')).toEqual(['work', 'workout', 'homework'])
+    expect(suggestTags(tags, '')).toEqual(['homework', 'ideas', 'w', 'work', 'workout'])
+    expect(suggestTags(tags, 'zzz')).toEqual([])
+  })
+  it('limits the list', () => {
+    expect(suggestTags(tags, '', 2)).toHaveLength(2)
+  })
+})
+
+describe('applyTag', () => {
+  it('replaces the partial tag and adds a space', () => {
+    const md = 'buy #gr'
+    const r = applyTag(md, { start: 4, prefix: 'gr' }, 7, 'groceries')
+    expect(r.text).toBe('buy #groceries ')
+    expect(r.caret).toBe(15)
+    expect(md.slice(0, r.from) + r.insert + md.slice(r.to)).toBe(r.text)
+  })
+  it('does not double a following space and swallows the rest of the word', () => {
+    expect(applyTag('#gr x', { start: 0, prefix: 'gr' }, 3, 'groceries').text).toBe('#groceries x')
+    expect(applyTag('#grXYZ x', { start: 0, prefix: 'gr' }, 3, 'groceries').text).toBe('#groceries x')
+  })
+})
+
+describe('tags in the preview', () => {
+  it('renders tags as safe, clickable chips', () => {
+    expect(renderMarkdown('hi #Work')).toBe(
+      '<p>hi <button type="button" class="tag" data-tag="work">#Work</button></p>',
+    )
+  })
+  it('does not render chips for headings, code or link anchors', () => {
+    const html = renderMarkdown('# Title\n\n`#x` [a](#b) https://x.com/#c\n\n```\n#d\n```')
+    expect(html).not.toContain('class="tag"')
+  })
+  it('renders chips inside lists, tasks and emphasis', () => {
+    const html = renderMarkdown('- [ ] call #home\n- **#urgent**')
+    expect(html).toContain('data-tag="home"')
+    expect(html).toContain('<strong><button type="button" class="tag" data-tag="urgent">#urgent</button></strong>')
+  })
+})
diff --git a/src/lib/tags.ts b/src/lib/tags.ts
new file mode 100644
index 0000000..14baf68
--- /dev/null
+++ b/src/lib/tags.ts
@@ -0,0 +1,148 @@
+// #tags written in note text.
+//
+// A tag is `#` + a letter, then letters, digits or `_`, optionally joined by
+// `-` or `/` (#todo, #work-items, #project/alpha). It must start a word: at the
+// start of a line, after whitespace, or after an opening bracket or quote.
+// So `# Heading`, `#1`, `a#b`, `https://x.com/#frag` and `[x](#anchor)` are not
+// tags. Text inside fenced code blocks and `inline code` never holds tags.
+// Tags are case-insensitive and reported in lower case.
+
+const BODY = String.raw`\p{L}[\p{L}\p{N}_]*(?:[-/][\p{L}\p{N}_]+)*`
+const BEFORE = String.raw`(?<=^|[\s[{,;:"'*_~>]|(?<!\])\()`
+
+export const tagRegex = () => new RegExp(`${BEFORE}#(${BODY})`, 'gu')
+const VALID_RE = new RegExp(`^#?(${BODY})$`, 'u')
+const PARTIAL_RE = new RegExp(`${BEFORE}#([\\p{L}\\p{N}_\\-/]*)$`, 'u')
+
+const FENCE_RE = /^\s*(`{3,}|~{3,})/
+const CODE_SPAN_RE = /(`+)([^`]|[^`][\s\S]*?[^`])\1(?!`)/g
+
+/** Applies `fn` to every stretch of text outside code blocks and code spans. */
+export function mapOutsideCode(md: string, fn: (text: string) => string): string {
+  let fence: string | null = null
+  return md
+    .split('\n')
+    .map((line) => {
+      if (fence) {
+        if (line.trim().startsWith(fence)) fence = null
+        return line
+      }
+      const f = FENCE_RE.exec(line)
+      if (f) {
+        fence = f[1]
+        return line
+      }
+      let out = ''
+      let last = 0
+      for (const m of line.matchAll(CODE_SPAN_RE)) {
+        out += fn(line.slice(last, m.index)) + m[0]
+        last = m.index + m[0].length
+      }
+      return out + fn(line.slice(last))
+    })
+    .join('\n')
+}
+
+/** Tags in a note, lower-cased, in order of first appearance. */
+export function extractTags(md: string): string[] {
+  const found = new Set<string>()
+  mapOutsideCode(md, (text) => {
+    for (const m of text.matchAll(tagRegex())) found.add(m[1].toLowerCase())
+    return text
+  })
+  return [...found]
+}
+
+export interface TagCount {
+  tag: string
+  count: number
+}
+
+/** Every tag with the number of notes that use it, alphabetical. */
+export function tagCounts(contents: string[]): TagCount[] {
+  const counts = new Map<string, number>()
+  for (const c of contents) for (const t of extractTags(c)) counts.set(t, (counts.get(t) ?? 0) + 1)
+  return [...counts]
+    .map(([tag, count]) => ({ tag, count }))
+    .sort((a, b) => a.tag.localeCompare(b.tag))
+}
+
+/** Normalises user input to a tag name (without '#'), or null if it isn't one. */
+export function normalizeTag(input: string): string | null {
+  const m = VALID_RE.exec(input.trim())
+  return m ? m[1] : null
+}
+
+/** Replaces every `#from` (any case) outside code with `#to`. */
+export function renameTag(md: string, from: string, to: string): string {
+  const key = from.toLowerCase()
+  return mapOutsideCode(md, (text) =>
+    text.replace(tagRegex(), (m, body: string) => (body.toLowerCase() === key ? `#${to}` : m)),
+  )
+}
+
+/** True if `offset` falls inside a fenced code block. */
+function inFence(md: string, offset: number): boolean {
+  let fence: string | null = null
+  for (const line of md.slice(0, offset).split('\n').slice(0, -1)) {
+    if (fence) {
+      if (line.trim().startsWith(fence)) fence = null
+    } else {
+      const f = FENCE_RE.exec(line)
+      if (f) fence = f[1]
+    }
+  }
+  return fence !== null
+}
+
+export interface TagQuery {
+  /** Index of the '#'. */
+  start: number
+  /** What has been typed after '#'. */
+  prefix: string
+}
+
+/** If the caret sits right after a `#partial` tag being typed, returns it. */
+export function tagQueryAt(md: string, caret: number): TagQuery | null {
+  const lineStart = md.lastIndexOf('\n', caret - 1) + 1
+  const before = md.slice(lineStart, caret)
+  const m = PARTIAL_RE.exec(before)
+  if (!m) return null
+  // Not inside inline code: an odd number of backticks before the caret on this line.
+  if ((before.slice(0, m.index).match(/`/g)?.length ?? 0) % 2 === 1) return null
+  if (inFence(md, caret)) return null
+  return { start: lineStart + m.index, prefix: m[1] }
+}
+
+/**
+ * Existing tags to offer for `prefix`: those starting with it first, then those
+ * containing it. The exact tag already typed is left out (Enter then still
+ * makes a new line), and so is a tag the caller marks as the partial one.
+ */
+export function suggestTags(tags: string[], prefix: string, limit = 8): string[] {
+  const p = prefix.toLowerCase()
+  const starts = tags.filter((t) => t.startsWith(p) && t !== p)
+  const contains = tags.filter((t) => !t.startsWith(p) && t.includes(p))
+  return [...starts.sort(), ...contains.sort()].slice(0, limit)
+}
+
+/** The text after choosing `tag` for the query at `q` with the caret at `caret`. */
+export function applyTag(
+  md: string,
+  q: TagQuery,
+  caret: number,
+  tag: string,
+): { text: string; caret: number; from: number; to: number; insert: string } {
+  const after = md.slice(caret)
+  // Swallow the rest of a half-typed word the caret is in the middle of.
+  const rest = /^[\p{L}\p{N}_\-/]*/u.exec(after)![0]
+  const tail = after.slice(rest.length)
+  const insert = `#${tag}` + (/^\s/.test(tail) ? '' : ' ')
+  return {
+    text: md.slice(0, q.start) + insert + tail,
+    caret: q.start + insert.length,
+    from: q.start,
+    to: caret + rest.length,
+    insert,
+  }
+}
