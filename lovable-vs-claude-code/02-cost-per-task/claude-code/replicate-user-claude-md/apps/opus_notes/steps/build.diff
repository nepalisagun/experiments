diff --git a/src/lib/markdown.test.ts b/src/lib/markdown.test.ts
new file mode 100644
index 0000000..016d8cb
--- /dev/null
+++ b/src/lib/markdown.test.ts
@@ -0,0 +1,159 @@
+import { describe, expect, it } from 'vitest'
+import { countWords, renderInline, renderMarkdown, safeUrl, toggleTask } from './markdown'
+
+describe('renderMarkdown: blocks', () => {
+  it('renders headings h1-h6', () => {
+    expect(renderMarkdown('# One')).toBe('<h1>One</h1>')
+    expect(renderMarkdown('### Three ###')).toBe('<h3>Three</h3>')
+    expect(renderMarkdown('###### Six')).toBe('<h6>Six</h6>')
+    expect(renderMarkdown('#NoSpace')).toBe('<p>#NoSpace</p>')
+  })
+
+  it('renders paragraphs with line breaks', () => {
+    expect(renderMarkdown('a\nb\n\nc')).toBe('<p>a<br>b</p>\n<p>c</p>')
+  })
+
+  it('renders bullet and numbered lists', () => {
+    expect(renderMarkdown('- a\n- b')).toBe('<ul><li>a</li><li>b</li></ul>')
+    expect(renderMarkdown('1. a\n2. b')).toBe('<ol><li>a</li><li>b</li></ol>')
+    expect(renderMarkdown('* a\n+ b')).toBe('<ul><li>a</li><li>b</li></ul>')
+  })
+
+  it('nests lists by indentation', () => {
+    expect(renderMarkdown('- a\n  - b\n- c')).toBe('<ul><li>a<ul><li>b</li></ul></li><li>c</li></ul>')
+    expect(renderMarkdown('- a\n  1. x')).toBe('<ul><li>a<ol><li>x</li></ol></li></ul>')
+  })
+
+  it('renders task lists with checkboxes tagged by source line', () => {
+    const html = renderMarkdown('intro\n\n- [ ] todo\n- [x] done')
+    expect(html).toContain('<ul class="task-list">')
+    expect(html).toContain('<input type="checkbox" data-line="2">')
+    expect(html).toContain('<input type="checkbox" data-line="3" checked>')
+    expect(html).toContain('<span>todo</span>')
+  })
+
+  it('renders fenced code blocks verbatim and escaped', () => {
+    const html = renderMarkdown('```js\nconst a = **b** < 3\n- [ ] not a task\n```')
+    expect(html).toBe(
+      '<pre><code class="language-js">const a = **b** &lt; 3\n- [ ] not a task</code></pre>',
+    )
+  })
+
+  it('handles an unterminated fence', () => {
+    expect(renderMarkdown('```\ncode')).toBe('<pre><code>code</code></pre>')
+  })
+
+  it('renders blockquotes and horizontal rules', () => {
+    expect(renderMarkdown('> quote')).toBe('<blockquote><p>quote</p></blockquote>')
+    expect(renderMarkdown('---')).toBe('<hr>')
+  })
+})
+
+describe('renderInline', () => {
+  it('renders bold, italic, both, strikethrough', () => {
+    expect(renderInline('**b** *i* __b2__ _i2_ ***bi*** ~~s~~')).toBe(
+      '<strong>b</strong> <em>i</em> <strong>b2</strong> <em>i2</em> <strong><em>bi</em></strong> <del>s</del>',
+    )
+  })
+
+  it('does not italicise snake_case words', () => {
+    expect(renderInline('some_var_name')).toBe('some_var_name')
+  })
+
+  it('renders inline code without formatting inside', () => {
+    expect(renderInline('`**x** <b>`')).toBe('<code>**x** &lt;b&gt;</code>')
+  })
+
+  it('renders links with safe attributes', () => {
+    expect(renderInline('[Ex **bold**](https://example.com/?a=1&b=2)')).toBe(
+      '<a href="https://example.com/?a=1&amp;b=2" target="_blank" rel="noopener noreferrer">Ex <strong>bold</strong></a>',
+    )
+  })
+
+  it('autolinks bare URLs', () => {
+    expect(renderInline('see https://example.com.')).toBe(
+      'see <a href="https://example.com" target="_blank" rel="noopener noreferrer">https://example.com</a>.',
+    )
+  })
+})
+
+describe('safety', () => {
+  it('escapes raw HTML so scripts never become elements', () => {
+    const html = renderMarkdown('<script>alert(1)</script>\n\n<img src=x onerror=alert(1)>')
+    expect(html).not.toContain('<script')
+    expect(html).not.toContain('<img')
+    expect(html).toContain('&lt;script&gt;alert(1)&lt;/script&gt;')
+  })
+
+  it('escapes HTML inside headings, lists and tasks', () => {
+    const html = renderMarkdown('# <b onclick=x>\n- <iframe>\n- [ ] <svg onload=x>')
+    expect(html).not.toMatch(/<(b|iframe|svg)[\s>]/)
+  })
+
+  it('drops javascript: and data: links but keeps their text', () => {
+    expect(renderInline('[click](javascript:alert(1))')).not.toContain('href')
+    expect(renderInline('[click](JaVaScRiPt:alert(1))')).not.toContain('<a')
+    expect(renderInline('[x](data:text/html,<script>)')).not.toContain('<a')
+    expect(renderInline('[x](vbscript:msgbox)')).not.toContain('<a')
+  })
+
+  it('cannot break out of attributes with quotes', () => {
+    const html = renderInline('[x](https://a.com/"onmouseover="alert(1))')
+    expect(html).not.toMatch(/"\s*onmouseover=/)
+  })
+
+  it('allows http, https, mailto and relative URLs', () => {
+    expect(safeUrl('https://a.com')).toBe('https://a.com')
+    expect(safeUrl('mailto:a@b.c')).toBe('mailto:a@b.c')
+    expect(safeUrl('/path#x')).toBe('/path#x')
+    expect(safeUrl('java\tscript:alert(1)')).toBeNull()
+  })
+
+  it('ignores injected placeholder characters', () => {
+    expect(renderInline('\u00000\u0000 `x`')).toBe('0 <code>x</code>')
+  })
+})
+
+describe('toggleTask', () => {
+  const src = 'title\n- [ ] one\n- [x] two\n  * [X] three\n1. [ ] four\nplain'
+  it('checks an unchecked task', () => {
+    expect(toggleTask(src, 1).split('\n')[1]).toBe('- [x] one')
+  })
+  it('unchecks checked tasks (x and X)', () => {
+    expect(toggleTask(src, 2).split('\n')[2]).toBe('- [ ] two')
+    expect(toggleTask(src, 3).split('\n')[3]).toBe('  * [ ] three')
+  })
+  it('works for numbered tasks', () => {
+    expect(toggleTask(src, 4).split('\n')[4]).toBe('1. [x] four')
+  })
+  it('leaves non-task lines and out-of-range lines alone', () => {
+    expect(toggleTask(src, 0)).toBe(src)
+    expect(toggleTask(src, 5)).toBe(src)
+    expect(toggleTask(src, 99)).toBe(src)
+  })
+  it('only touches the targeted line', () => {
+    const out = toggleTask(src, 1).split('\n')
+    expect(out.slice(2)).toEqual(src.split('\n').slice(2))
+  })
+  it('preserves CRLF line endings', () => {
+    expect(toggleTask('a\r\n- [ ] b\r\nc', 1)).toBe('a\r\n- [x] b\r\nc')
+  })
+  it('round-trips with the rendered data-line', () => {
+    const md = 'x\n\n```\n- [ ] in code\n```\n- [ ] real'
+    const line = Number(/data-line="(\d+)"/.exec(renderMarkdown(md))![1])
+    expect(toggleTask(md, line).endsWith('- [x] real')).toBe(true)
+    expect(toggleTask(md, line)).toContain('- [ ] in code')
+  })
+})
+
+describe('countWords', () => {
+  it('counts words, ignoring Markdown punctuation', () => {
+    expect(countWords('')).toBe(0)
+    expect(countWords('   \n ')).toBe(0)
+    expect(countWords('# Hello **world**')).toBe(2)
+    expect(countWords('- [ ] buy milk\n- [x] done')).toBe(3)
+    expect(countWords("don't stop")).toBe(2)
+    expect(countWords('[my site](https://example.com/a/b)')).toBe(2)
+    expect(countWords('zażółć gęślą 42')).toBe(3)
+  })
+})
diff --git a/src/lib/markdown.ts b/src/lib/markdown.ts
new file mode 100644
index 0000000..43c9dc4
--- /dev/null
+++ b/src/lib/markdown.ts
@@ -0,0 +1,219 @@
+// A small Markdown renderer. Safety comes from construction: every piece of
+// note text is HTML-escaped before any tag is emitted, so raw HTML in a note
+// is shown as text and can never run. Link URLs are limited to safe schemes.
+
+export function escapeHtml(s: string): string {
+  return s
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&#39;')
+}
+
+/** Returns a safe href, or null if the URL uses a scheme we don't allow. */
+export function safeUrl(raw: string): string | null {
+  const url = raw.trim()
+  // Strip characters browsers ignore inside schemes ("java\tscript:").
+  // eslint-disable-next-line no-control-regex
+  const probe =url.replace(/[\u0000- \u007f]/g, '').toLowerCase()
+  const scheme = /^([a-z][a-z0-9+.-]*):/.exec(probe)
+  if (scheme && !['http', 'https', 'mailto'].includes(scheme[1])) return null
+  return url
+}
+
+const PH = '\u0000' // placeholder marker; stripped from input first
+
+export function renderInline(text: string): string {
+  const slots: string[] = []
+  const stash = (html: string) => `${PH}${slots.push(html) - 1}${PH}`
+  let s = text.replace(new RegExp(PH, 'g'), '')
+
+  // Code spans first, so their contents are not formatted.
+  s = s.replace(/(`+)([^`]|[^`][\s\S]*?[^`])\1(?!`)/g, (_, _t, code: string) =>
+    stash(`<code>${escapeHtml(code.trim() === '' ? code : code.replace(/^ (.*) $/, '$1'))}</code>`),
+  )
+
+  // Links: [text](url "optional title")
+  s = s.replace(/\[([^\]]*)\]\(\s*<?([^\s)>]*)>?(?:\s+"([^"]*)")?\s*\)/g, (m, label: string, url: string, title?: string) => {
+    const href = safeUrl(url)
+    if (href === null) return stash(renderEmphasis(escapeHtml(label)))
+    if (!url) return m
+    const t = title ? ` title="${escapeHtml(title)}"` : ''
+    return stash(
+      `<a href="${escapeHtml(href)}"${t} target="_blank" rel="noopener noreferrer">${renderEmphasis(escapeHtml(label))}</a>`,
+    )
+  })
+
+  // Bare autolinks
+  s = s.replace(/\bhttps?:\/\/[^\s<]*[^\s<.,:;"')\]!?]/g, (url) =>
+    stash(`<a href="${escapeHtml(url)}" target="_blank" rel="noopener noreferrer">${escapeHtml(url)}</a>`),
+  )
+
+  s = renderEmphasis(escapeHtml(s))
+  return s.replace(new RegExp(`${PH}(\\d+)${PH}`, 'g'), (_, i: string) => slots[Number(i)])
+}
+
+/** Bold / italic / strikethrough on already-escaped text. */
+function renderEmphasis(s: string): string {
+  return s
+    .replace(/(\*\*\*|___)(?=\S)([\s\S]*?\S)\1/g, '<strong><em>$2</em></strong>')
+    .replace(/\*\*(?=\S)([\s\S]*?\S)\*\*/g, '<strong>$1</strong>')
+    .replace(/(^|[^\w])__(?=\S)([\s\S]*?\S)__(?!\w)/g, '$1<strong>$2</strong>')
+    .replace(/\*(?=\S)([^*]*?\S)\*/g, '<em>$1</em>')
+    .replace(/(^|[^\w])_(?=\S)([^_]*?\S)_(?!\w)/g, '$1<em>$2</em>')
+    .replace(/~~(?=\S)([\s\S]*?\S)~~/g, '<del>$1</del>')
+}
+
+const LIST_RE = /^(\s*)([-*+]|\d+[.)])\s+(.*)$/
+const TASK_RE = /^\[([ xX])\](?:\s+|$)(.*)$/
+const FENCE_RE = /^\s*(`{3,}|~{3,})\s*([\w+-]*)/
+
+interface ListItem {
+  indent: number
+  ordered: boolean
+  text: string
+  line: number
+  children: ListItem[]
+}
+
+function renderList(items: ListItem[]): string {
+  if (items.length === 0) return ''
+  const ordered = items[0].ordered
+  const hasTask = items.some((i) => TASK_RE.test(i.text))
+  const tag = ordered ? 'ol' : 'ul'
+  let html = `<${tag}${hasTask ? ' class="task-list"' : ''}>`
+  for (const it of items) {
+    const task = TASK_RE.exec(it.text)
+    if (task) {
+      const checked = task[1] !== ' '
+      html +=
+        `<li class="task-item"><label><input type="checkbox" data-line="${it.line}"${checked ? ' checked' : ''}> ` +
+        `<span>${renderInline(task[2])}</span></label>`
+    } else {
+      html += `<li>${renderInline(it.text)}`
+    }
+    html += renderList(it.children) + '</li>'
+  }
+  return html + `</${tag}>`
+}
+
+function nestItems(flat: ListItem[]): ListItem[] {
+  const root: ListItem[] = []
+  const stack: ListItem[] = []
+  for (const it of flat) {
+    while (stack.length && stack[stack.length - 1].indent >= it.indent) stack.pop()
+    if (stack.length) stack[stack.length - 1].children.push(it)
+    else root.push(it)
+    stack.push(it)
+  }
+  return root
+}
+
+export function renderMarkdown(src: string): string {
+  const lines = src.replace(/\r\n?/g, '\n').split('\n')
+  const out: string[] = []
+  let i = 0
+
+  while (i < lines.length) {
+    const line = lines[i]
+
+    if (line.trim() === '') {
+      i++
+      continue
+    }
+
+    // Fenced code block
+    const fence = FENCE_RE.exec(line)
+    if (fence) {
+      const marker = fence[1]
+      const lang = fence[2]
+      const body: string[] = []
+      i++
+      while (i < lines.length && !lines[i].trim().startsWith(marker)) body.push(lines[i++])
+      i++ // closing fence (or end of input)
+      const cls = lang ? ` class="language-${escapeHtml(lang)}"` : ''
+      out.push(`<pre><code${cls}>${escapeHtml(body.join('\n'))}</code></pre>`)
+      continue
+    }
+
+    // Heading
+    const h = /^(#{1,6})\s+(.*?)\s*#*\s*$/.exec(line)
+    if (h) {
+      const n = h[1].length
+      out.push(`<h${n}>${renderInline(h[2])}</h${n}>`)
+      i++
+      continue
+    }
+
+    // Horizontal rule
+    if (/^\s*([-*_])(\s*\1){2,}\s*$/.test(line)) {
+      out.push('<hr>')
+      i++
+      continue
+    }
+
+    // Blockquote
+    if (/^\s*>/.test(line)) {
+      const body: string[] = []
+      while (i < lines.length && /^\s*>/.test(lines[i])) body.push(lines[i++].replace(/^\s*>\s?/, ''))
+      out.push(`<blockquote>${renderMarkdown(body.join('\n'))}</blockquote>`)
+      continue
+    }
+
+    // List (consecutive list lines; indented continuation lines join the item)
+    if (LIST_RE.test(line)) {
+      const flat: ListItem[] = []
+      while (i < lines.length) {
+        const m = LIST_RE.exec(lines[i])
+        if (m) {
+          const ordered = /\d/.test(m[2])
+          // A switch between bullet and numbered at the top level starts a new list.
+          if (flat.length && m[1].length <= flat[0].indent && ordered !== flat[0].ordered) break
+          flat.push({ indent: m[1].length, ordered, text: m[3], line: i, children: [] })
+          i++
+        } else if (flat.length && lines[i].trim() !== '' && /^\s+/.test(lines[i])) {
+          flat[flat.length - 1].text += ' ' + lines[i].trim()
+          i++
+        } else break
+      }
+      out.push(renderList(nestItems(flat)))
+      continue
+    }
+
+    // Paragraph
+    const para: string[] = []
+    while (
+      i < lines.length &&
+      lines[i].trim() !== '' &&
+      !FENCE_RE.test(lines[i]) &&
+      !/^#{1,6}\s/.test(lines[i]) &&
+      !/^\s*>/.test(lines[i]) &&
+      !LIST_RE.test(lines[i])
+    ) {
+      para.push(lines[i++])
+    }
+    out.push(`<p>${para.map((l) => renderInline(l.trim())).join('<br>')}</p>`)
+  }
+
+  return out.join('\n')
+}
+
+/** Flip the checkbox of the task item on source line `lineIndex`. */
+export function toggleTask(src: string, lineIndex: number): string {
+  const eol = src.includes('\r\n') ? '\r\n' : '\n'
+  const lines = src.split(/\r?\n/)
+  const line = lines[lineIndex]
+  if (line === undefined) return src
+  const m = /^(\s*(?:[-*+]|\d+[.)])\s+\[)([ xX])(\].*)$/.exec(line)
+  if (!m) return src
+  lines[lineIndex] = m[1] + (m[2] === ' ' ? 'x' : ' ') + m[3]
+  return lines.join(eol)
+}
+
+export function countWords(src: string): number {
+  const text = src
+    .replace(/^(\s*(?:[-*+]|\d+[.)])\s+)\[[ xX]\]/gm, '$1') // task markers
+    .replace(/\]\([^)]*\)/g, ']') // link URLs
+  return (text.match(/[\p{L}\p{N}]+(?:['’][\p{L}\p{N}]+)*/gu) ?? []).length
+}
