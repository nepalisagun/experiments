+            <section className={card} aria-labelledby="tx-h">
+              <div className="mb-3 flex flex-wrap items-baseline justify-between gap-2">
+                <h2 id="tx-h" className="text-base font-semibold">Transactions</h2>
+                <span className="text-xs text-stone-500" data-testid="tx-count">
+                  {filtered ? `Showing ${visible.length} of ${monthTx.length}` : `${monthTx.length} this month`}
+                </span>
+              </div>
+              <div className="mb-3 grid grid-cols-2 gap-2 sm:grid-cols-[1fr_1fr_2fr]">
+                <label className="sr-only" htmlFor="f-cat">Filter by category</label>
+                <select id="f-cat" className={control} value={filters.categoryId} onChange={(e) => setFilters({ ...filters, categoryId: e.target.value })}>
+                  <option value="">All categories</option>
+                  {data.categories.map((c) => <option key={c.id} value={c.id}>{c.name}</option>)}
+                </select>
+                <label className="sr-only" htmlFor="f-type">Filter by type</label>
+                <select id="f-type" className={control} value={filters.type} onChange={(e) => setFilters({ ...filters, type: e.target.value as Filters['type'] })}>
+                  <option value="">All types</option>
+                  <option value="income">Income</option>
+                  <option value="expense">Expense</option>
+                </select>
+                <label className="sr-only" htmlFor="f-search">Search notes</label>
+                <input id="f-search" type="search" placeholder="Search notes…" className={`${control} col-span-2 sm:col-span-1`} value={filters.search} onChange={(e) => setFilters({ ...filters, search: e.target.value })} />
+              </div>
+
+              {visible.length === 0 ? (
+                <div className="py-8 text-center text-sm text-stone-500">
+                  {monthTx.length === 0 ? `No transactions in ${monthLabel(month)}.` : 'No transactions match the filters.'}
+                  {filtered && (
+                    <button type="button" className="ml-2 font-medium text-stone-800 underline" onClick={() => setFilters({ categoryId: '', type: '', search: '' })}>Clear filters</button>
+                  )}
+                </div>
+              ) : (
+                <ul className="divide-y divide-stone-100" aria-label="Transactions">
+                  {visible.map((t) => {
+                    const c = catById.get(t.categoryId)
+                    return (
+                      <li key={t.id} data-testid="tx-row" className={`flex items-center gap-3 py-2.5 ${editingId === t.id ? 'bg-amber-50' : ''}`}>
+                        <span className="h-2.5 w-2.5 shrink-0 rounded-full" style={{ background: c?.color ?? '#999' }} aria-hidden="true" />
+                        <div className="min-w-0 flex-1">
+                          <div className="truncate text-sm font-medium text-stone-900">{t.note || <span className="text-stone-500">{c?.name ?? 'Unknown'}</span>}</div>
+                          <div className="text-xs text-stone-500">
+                            {c?.name ?? 'Unknown'} · {new Date(t.date + 'T00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
+                          </div>
+                        </div>
+                        <span className={`shrink-0 text-sm font-semibold tabular-nums ${t.type === 'income' ? 'text-green-800' : 'text-stone-900'}`} data-testid="tx-amount">
+                          {t.type === 'income' ? '+' : '−'}{formatCents(t.amountCents)}
+                        </span>
+                        <div className="flex shrink-0 gap-0.5">
+                          <button type="button" onClick={() => setEditingId(t.id)} className="rounded px-2 py-1 text-xs font-medium text-stone-600 hover:bg-stone-100" aria-label={`Edit ${t.note || c?.name}`}>Edit</button>
+                          <button type="button" onClick={() => deleteTx(t)} className="rounded px-2 py-1 text-xs font-medium text-red-700 hover:bg-red-50" aria-label={`Delete ${t.note || c?.name}`}>Delete</button>
+                        </div>
+                      </li>
+                    )
+                  })}
+                </ul>
+              )}
+            </section>
+          </div>
+        </div>
+      </main>
+    </div>
+  )
+}
+
+function Stat({ label, cents, tone, testId }: { label: string; cents: number; tone: string; testId: string }) {
+  return (
+    <div className={`${card} flex items-baseline justify-between sm:block`}>
+      <div className="text-xs font-medium uppercase tracking-wide text-stone-500">{label}</div>
+      <div className={`text-xl font-semibold tabular-nums sm:mt-1 sm:text-2xl ${tone}`} data-testid={testId}>{formatCents(cents)}</div>
+    </div>
+  )
 }
diff --git a/src/components/Categories.tsx b/src/components/Categories.tsx
new file mode 100644
index 0000000..529b8c1
--- /dev/null
+++ b/src/components/Categories.tsx
@@ -0,0 +1,163 @@
+import { useState, type FormEvent } from 'react'
+import { CUSTOM_COLORS, validateCategoryName, type BudgetStatus, type Category } from '../lib/budget.ts'
+import { centsToPlain, formatCents, parseAmount } from '../lib/money.ts'
+
+function BudgetInput({ category, onChange }: { category: Category; onChange: (cents: number | null) => void }) {
+  const initial = category.budgetCents ? centsToPlain(category.budgetCents) : ''
+  const [value, setValue] = useState(initial)
+  const [error, setError] = useState<string | null>(null)
+  const [prev, setPrev] = useState(initial)
+  if (prev !== initial) {
+    setPrev(initial)
+    setValue(initial)
+  }
+
+  const commit = () => {
+    if (value.trim() === '') {
+      setError(null)
+      if (category.budgetCents !== null) onChange(null)
+      return
+    }
+    const r = parseAmount(value)
+    if (!r.ok) return setError(r.error)
+    setError(null)
+    setValue(centsToPlain(r.cents))
+    if (r.cents !== category.budgetCents) onChange(r.cents)
+  }
+
+  const id = `budget-${category.id}`
+  return (
+    <div className="w-28 shrink-0">
+      <label htmlFor={id} className="sr-only">Monthly budget for {category.name}</label>
+      <input
+        id={id}
+        inputMode="decimal"
+        placeholder="No budget"
+        value={value}
+        onChange={(e) => setValue(e.target.value)}
+        onBlur={commit}
+        onKeyDown={(e) => e.key === 'Enter' && (e.currentTarget.blur())}
+        aria-invalid={!!error}
+        aria-describedby={error ? `${id}-error` : undefined}
+        className={`w-full rounded-md border px-2 py-1 text-right text-sm tabular-nums outline-none focus:ring-2 ${
+          error ? 'border-red-600 focus:ring-red-200' : 'border-stone-300 focus:ring-stone-200'
+        }`}
+      />
+      {error && <p id={`${id}-error`} role="alert" className="mt-1 text-right text-xs text-red-700">{error}</p>}
+    </div>
+  )
+}
+
+interface Props {
+  categories: Category[]
+  usage: Map<string, number>
+  onAdd: (name: string, color: string) => void
+  onBudget: (id: string, cents: number | null) => void
+  onDelete: (id: string) => void
+}
+
+export function CategoriesPanel({ categories, usage, onAdd, onBudget, onDelete }: Props) {
+  const nextColor = CUSTOM_COLORS[categories.filter((c) => !c.builtIn).length % CUSTOM_COLORS.length]
+  const [name, setName] = useState('')
+  const [color, setColor] = useState(nextColor)
+  const [error, setError] = useState<string | null>(null)
+
+  const add = (e: FormEvent) => {
+    e.preventDefault()
+    const msg = validateCategoryName(name, categories)
+    if (msg) return setError(msg)
+    onAdd(name.trim(), color)
+    setName('')
+    setError(null)
+    setColor(CUSTOM_COLORS[(categories.filter((c) => !c.builtIn).length + 1) % CUSTOM_COLORS.length])
+  }
+
+  return (
+    <section className="space-y-3" aria-labelledby="cats-h">
+      <div>
+        <h2 id="cats-h" className="text-base font-semibold text-stone-900">Categories &amp; budgets</h2>
+        <p className="text-xs text-stone-500">Set a monthly budget per category. Leave empty for none.</p>
+      </div>
+      <ul className="divide-y divide-stone-100">
+        {categories.map((c) => (
+          <li key={c.id} className="flex items-start gap-2 py-1.5" data-testid={`cat-row-${c.name}`}>
+            <span className="mt-2 h-3 w-3 shrink-0 rounded-full" style={{ background: c.color }} aria-hidden="true" />
+            <span className="mt-1 min-w-0 flex-1 truncate text-sm text-stone-800">{c.name}</span>
+            <BudgetInput category={c} onChange={(cents) => onBudget(c.id, cents)} />
+            {!c.builtIn ? (
+              <button
+                type="button"
+                onClick={() => {
+                  const n = usage.get(c.id) ?? 0
+                  if (window.confirm(n ? `Delete "${c.name}"? Its ${n} transaction(s) will move to Other.` : `Delete "${c.name}"?`)) onDelete(c.id)
+                }}
+                className="mt-0.5 rounded px-1.5 py-1 text-xs text-stone-500 hover:bg-red-50 hover:text-red-700"
+                aria-label={`Delete category ${c.name}`}
+              >
+                ✕
+              </button>
+            ) : (
+              <span className="w-[26px] shrink-0" aria-hidden="true" />
+            )}
+          </li>
+        ))}
+      </ul>
+      <form onSubmit={add} noValidate className="space-y-1" aria-label="Add category">
+        <div className="flex gap-2">
+          <label htmlFor="new-cat-color" className="sr-only">Colour</label>
+          <input id="new-cat-color" type="color" value={color} onChange={(e) => setColor(e.target.value)} className="h-9 w-10 shrink-0 cursor-pointer rounded-md border border-stone-300 bg-white p-1" />
+          <label htmlFor="new-cat-name" className="sr-only">New category name</label>
+          <input
+            id="new-cat-name"
+            value={name}
+            onChange={(e) => { setName(e.target.value); setError(null) }}
+            placeholder="New category"
+            aria-invalid={!!error}
+            aria-describedby={error ? 'new-cat-error' : undefined}
+            className={`min-w-0 flex-1 rounded-lg border px-3 py-2 text-sm outline-none focus:ring-2 ${error ? 'border-red-600 focus:ring-red-200' : 'border-stone-300 focus:ring-stone-200'}`}
+          />
+          <button type="submit" className="shrink-0 rounded-lg border border-stone-300 px-3 py-2 text-sm font-medium text-stone-700 hover:bg-stone-50">Add</button>
+        </div>
+        {error && <p id="new-cat-error" role="alert" className="text-xs font-medium text-red-700">{error}</p>}
+      </form>
+    </section>
+  )
+}
+
+export function BudgetBars({ statuses }: { statuses: BudgetStatus[] }) {
+  if (statuses.length === 0) {
+    return <p className="text-sm text-stone-500">No budgets set. Add one under “Categories &amp; budgets”.</p>
+  }
+  return (
+    <ul className="space-y-3">
+      {statuses.map((s) => (
+        <li key={s.category.id} data-testid={`budget-${s.category.name}`} data-over={s.over}>
+          <div className="mb-1 flex flex-wrap items-baseline justify-between gap-x-2 text-sm">
+            <span className="flex items-center gap-2 font-medium text-stone-800">
+              <span className="h-2.5 w-2.5 rounded-full" style={{ background: s.category.color }} aria-hidden="true" />
+              {s.category.name}
+            </span>
+            <span className={`tabular-nums ${s.over ? 'font-semibold text-red-700' : 'text-stone-600'}`}>
+              {formatCents(s.spentCents)} / {formatCents(s.budgetCents)}
+              {s.over && <> · over by {formatCents(s.spentCents - s.budgetCents)}</>}
+            </span>
+          </div>
+          <div
+            className="h-2.5 overflow-hidden rounded-full bg-stone-200"
+            role="progressbar"
+            aria-label={`${s.category.name} budget used`}
+            aria-valuemin={0}
+            aria-valuemax={100}
+            aria-valuenow={Math.round(s.ratio * 100)}
+          >
+            <div
+              data-testid="bar-fill"
+              className={`h-full rounded-full transition-[width] ${s.over ? 'bg-red-600' : 'bg-stone-700'}`}
+              style={{ width: `${s.ratio * 100}%` }}
+            />
+          </div>
+        </li>
+      ))}
+    </ul>
+  )
+}
diff --git a/src/components/DonutChart.tsx b/src/components/DonutChart.tsx
new file mode 100644
index 0000000..b9e6bfd
--- /dev/null
+++ b/src/components/DonutChart.tsx
@@ -0,0 +1,94 @@
+import { useState } from 'react'
+import type { CategorySlice } from '../lib/budget.ts'
+import { formatCents } from '../lib/money.ts'
+
+const R = 80
+const STROKE = 26
+const C = 2 * Math.PI * R
+const GAP = 2 // px of surface between segments
+
+export function DonutChart({ slices }: { slices: CategorySlice[] }) {
+  const [active, setActive] = useState<string | null>(null)
+  const total = slices.reduce((s, x) => s + x.cents, 0)
+
+  if (total === 0) {
+    return (
+      <div className="flex flex-col items-center gap-3 py-6 text-center text-sm text-stone-500" data-testid="donut-empty">
+        <svg viewBox="0 0 200 200" className="h-32 w-32" aria-hidden="true">
+          <circle cx="100" cy="100" r={R} fill="none" stroke="#e7e5e4" strokeWidth={STROKE} />
+        </svg>
+        No expenses this month yet.
+      </div>
+    )
+  }
+
+  let offset = 0
+  const segs = slices.map((s) => {
+    const len = (s.cents / total) * C
+    const seg = { ...s, len, offset }
+    offset += len
+    return seg
+  })
+  const activeSlice = slices.find((s) => s.category.id === active)
+  const pct = (cents: number) => {
+    const p = (cents / total) * 100
+    return cents === total ? '100%' : p < 0.1 ? '<0.1%' : p > 99.9 ? '>99.9%' : `${p.toFixed(1)}%`
+  }
+
+  return (
+    <div className="@container">
+    <div className="flex flex-col items-center gap-5 @md:flex-row">
+      <div className="relative h-44 w-44 shrink-0">
+        <svg viewBox="0 0 200 200" className="h-full w-full -rotate-90" role="img" aria-label={`Expenses by category, total ${formatCents(total)}`}>
+          {segs.map((s) => {
+            const visible = slices.length > 1 ? Math.max(s.len - GAP, 1.5) : C
+            return (
+              <circle
+                key={s.category.id}
+                data-testid={`donut-seg-${s.category.name}`}
+                cx="100"
+                cy="100"
+                r={R}
+                fill="none"
+                stroke={s.category.color}
+                strokeWidth={active === s.category.id ? STROKE + 6 : STROKE}
+                strokeDasharray={`${visible} ${C - visible}`}
+                strokeDashoffset={-s.offset}
+                className="cursor-pointer transition-[stroke-width] duration-150"
+                opacity={active && active !== s.category.id ? 0.35 : 1}
+                onMouseEnter={() => setActive(s.category.id)}
+                onMouseLeave={() => setActive(null)}
+              >
+                <title>{`${s.category.name}: ${formatCents(s.cents)} (${pct(s.cents)})`}</title>
+              </circle>
+            )
+          })}
+        </svg>
+        <div className="pointer-events-none absolute inset-0 flex flex-col items-center justify-center text-center" aria-live="polite">
+          <span className="text-xs text-stone-500">{activeSlice ? activeSlice.category.name : 'Total spent'}</span>
+          <span className="text-lg font-semibold tabular-nums text-stone-900">{formatCents(activeSlice ? activeSlice.cents : total)}</span>
+          {activeSlice && <span className="text-xs text-stone-500">{pct(activeSlice.cents)}</span>}
+        </div>
+      </div>
+      <ul className="w-full min-w-0 space-y-1 text-sm" aria-label="Expenses by category">
+        {slices.map((s) => (
+          <li
+            key={s.category.id}
+            tabIndex={0}
+            onMouseEnter={() => setActive(s.category.id)}
+            onMouseLeave={() => setActive(null)}
+            onFocus={() => setActive(s.category.id)}
+            onBlur={() => setActive(null)}
+            className={`flex items-center gap-2 rounded px-2 py-1 outline-none focus-visible:ring-2 focus-visible:ring-stone-400 ${active === s.category.id ? 'bg-stone-100' : ''}`}
+          >
+            <span className="h-3 w-3 shrink-0 rounded-sm" style={{ background: s.category.color }} aria-hidden="true" />
+            <span className="min-w-0 flex-1 truncate text-stone-700">{s.category.name}</span>
+            <span className="tabular-nums text-stone-900">{formatCents(s.cents)}</span>
+            <span className="w-14 shrink-0 text-right tabular-nums text-stone-500">{pct(s.cents)}</span>
+          </li>
+        ))}
+      </ul>
+    </div>
+    </div>
+  )
+}
diff --git a/src/components/TransactionForm.tsx b/src/components/TransactionForm.tsx
new file mode 100644
index 0000000..3020397
--- /dev/null
+++ b/src/components/TransactionForm.tsx
@@ -0,0 +1,156 @@
+import { useEffect, useState, type FormEvent } from 'react'
+import { MAX_NOTE, validateDraft, type Category, type DraftErrors, type Transaction, type TxDraft } from '../lib/budget.ts'
+import { centsToPlain } from '../lib/money.ts'
+
+interface Props {
+  categories: Category[]
+  defaultDate: string
+  editing: Transaction | null
+  onSubmit: (value: Omit<Transaction, 'id'>) => void
+  onCancel: () => void
+}
+
+const emptyDraft = (date: string, categoryId: string): TxDraft => ({ type: 'expense', amount: '', categoryId, date, note: '' })
+
+const inputCls = (bad: boolean) =>
+  `w-full rounded-lg border bg-white px-3 py-2 text-sm text-stone-900 outline-none focus:ring-2 ${
+    bad ? 'border-red-600 focus:ring-red-200' : 'border-stone-300 focus:border-stone-500 focus:ring-stone-200'
+  }`
+
+export function TransactionForm({ categories, defaultDate, editing, onSubmit, onCancel }: Props) {
+  const firstCat = categories[0]?.id ?? 'other'
+  const [draft, setDraft] = useState<TxDraft>(() => emptyDraft(defaultDate, firstCat))
+  const [errors, setErrors] = useState<DraftErrors>({})
+
+  // Load the transaction being edited, or reset when editing ends / month changes.
+  useEffect(() => {
+    setErrors({})
+    if (editing) {
+      setDraft({ type: editing.type, amount: centsToPlain(editing.amountCents), categoryId: editing.categoryId, date: editing.date, note: editing.note })
+    } else {
+      setDraft((d) => ({ ...emptyDraft(defaultDate, d.categoryId), type: d.type }))
+    }
+  }, [editing, defaultDate])
+
+  const set = <K extends keyof TxDraft>(k: K, v: TxDraft[K]) => {
+    setDraft((d) => ({ ...d, [k]: v }))
+    if (errors[k as keyof DraftErrors]) setErrors((e) => ({ ...e, [k]: undefined }))
+  }
+
+  const submit = (e: FormEvent) => {
+    e.preventDefault()
+    const r = validateDraft(draft, categories)
+    if (!r.ok) {
+      setErrors(r.errors)
+      const first = (['amount', 'date', 'categoryId', 'note'] as const).find((k) => r.errors[k])
+      if (first) document.getElementById(`tx-${first}`)?.focus()
+      return
+    }
+    onSubmit(r.value)
+    if (!editing) setDraft((d) => ({ ...emptyDraft(d.date, d.categoryId), type: d.type }))
+  }
+
+  const err = (k: keyof DraftErrors) =>
+    errors[k] ? (
+      <p id={`tx-${k}-error`} role="alert" className="mt-1 text-xs font-medium text-red-700">
+        {errors[k]}
+      </p>
+    ) : null
+
+  return (
+    <form onSubmit={submit} noValidate className="space-y-3" aria-label={editing ? 'Edit transaction' : 'Add transaction'}>
+      <h2 className="text-base font-semibold text-stone-900">{editing ? 'Edit transaction' : 'Add transaction'}</h2>
+
+      <fieldset>
+        <legend className="sr-only">Type</legend>
+        <div className="grid grid-cols-2 rounded-lg bg-stone-100 p-1 text-sm">
+          {(['expense', 'income'] as const).map((t) => (
+            <label
+              key={t}
+              className={`cursor-pointer rounded-md py-1.5 text-center font-medium capitalize has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-stone-400 ${
+                draft.type === t ? 'bg-white text-stone-900 shadow-sm' : 'text-stone-500'
+              }`}
+            >
+              <input type="radio" name="type" value={t} checked={draft.type === t} onChange={() => set('type', t)} className="sr-only" />
+              {t === 'expense' ? 'Expense' : 'Income'}
+            </label>
+          ))}
+        </div>
+      </fieldset>
+
+      <div className="grid grid-cols-2 gap-3">
+        <div>
+          <label htmlFor="tx-amount" className="mb-1 block text-xs font-medium text-stone-600">Amount</label>
+          <input
+            id="tx-amount"
+            inputMode="decimal"
+            autoComplete="off"
+            placeholder="0.00"
+            value={draft.amount}
+            onChange={(e) => set('amount', e.target.value)}
+            aria-invalid={!!errors.amount}
+            aria-describedby={errors.amount ? 'tx-amount-error' : undefined}
+            className={`${inputCls(!!errors.amount)} tabular-nums`}
+          />
+          {err('amount')}
+        </div>
+        <div>
+          <label htmlFor="tx-date" className="mb-1 block text-xs font-medium text-stone-600">Date</label>
+          <input
+            id="tx-date"
+            type="date"
+            value={draft.date}
+            onChange={(e) => set('date', e.target.value)}
+            aria-invalid={!!errors.date}
+            aria-describedby={errors.date ? 'tx-date-error' : undefined}
+            className={inputCls(!!errors.date)}
+          />
+          {err('date')}
+        </div>
+      </div>
+
+      <div>
+        <label htmlFor="tx-categoryId" className="mb-1 block text-xs font-medium text-stone-600">Category</label>
+        <select
+          id="tx-categoryId"
+          value={draft.categoryId}
+          onChange={(e) => set('categoryId', e.target.value)}
+          aria-invalid={!!errors.categoryId}
+          className={inputCls(!!errors.categoryId)}
+        >
+          {categories.map((c) => (
+            <option key={c.id} value={c.id}>{c.name}</option>
+          ))}
+        </select>
+        {err('categoryId')}
+      </div>
+
+      <div>
+        <label htmlFor="tx-note" className="mb-1 block text-xs font-medium text-stone-600">
+          Note <span className="font-normal text-stone-400">(optional)</span>
+        </label>
+        <input
+          id="tx-note"
+          value={draft.note}
+          maxLength={MAX_NOTE + 50}
+          onChange={(e) => set('note', e.target.value)}
+          placeholder="e.g. Groceries at the market"
+          aria-invalid={!!errors.note}
+          className={inputCls(!!errors.note)}
+        />
+        {err('note')}
+      </div>
+
+      <div className="flex gap-2">
+        <button type="submit" className="flex-1 rounded-lg bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-700">
+          {editing ? 'Save changes' : 'Add transaction'}
+        </button>
+        {editing && (
+          <button type="button" onClick={onCancel} className="rounded-lg border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 hover:bg-stone-50">
+            Cancel
+          </button>
+        )}
+      </div>
+    </form>
+  )
+}
